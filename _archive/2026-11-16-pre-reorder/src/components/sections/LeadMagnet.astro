---
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import { img, runSheet } from '../../data/content';
const page = 'absolute inset-0 flex flex-col rounded-[10px] p-[30px] shadow-[0_30px_60px_-30px_rgba(0,0,0,.35)]';
---
<section aria-label="Run-time sheet" class="bg-stone pb-[120px] pt-[130px] text-ink">
  <div class="wrap grid grid-cols-[repeat(2,1fr)] items-center gap-[70px] max-[900px]:grid-cols-[repeat(1,1fr)]">
    <div>
      <Eyebrow gold="Free download" />
      <Heading class="mt-4">Get the run-time sheet.</Heading>
      <p class="mt-[18px] max-w-[600px] text-[19px] text-ink-soft">Every tool we've tested, on every battery size, in February. One page, sent to your inbox.</p>
      <!-- TODO: connect this form to GoHighLevel -->
      <form class="mt-8 flex max-w-[480px] gap-2" onsubmit="return false">
        <label for="lm-email" class="sr-only">Email</label>
        <input id="lm-email" type="email" placeholder="you@company.com" class="flex-1 rounded-[10px] border border-[#D3D1CC] bg-paper px-[18px] py-[15px] text-[16px] text-ink placeholder:text-[#757575]" />
        <button type="button" class="cursor-pointer rounded-[10px] border-0 bg-ink px-[22px] text-[15px] font-semibold leading-[normal] text-white hover:bg-black">Send it</button>
      </form>
      <small class="mt-3 block text-[13px] text-ink-soft">Plus early word on new builds. No spam.</small>
    </div>

    <div class="relative aspect-[8.5/11] w-[min(420px,100%)] justify-self-center" aria-hidden="true">
      <div class={`${page} bg-[#F4F3F0] [transform:rotate(5deg)_translate(18px,6px)]`}></div>
      <div class={`${page} bg-white [transform:rotate(-2deg)]`}>
        <div class="-mx-[30px] -mt-[30px] mb-[22px] flex h-[70px] items-center justify-between rounded-t-[10px] bg-black px-[26px]">
          <img src={img.logoWhite} alt="" class="h-[18px] w-auto" />
          <span class="text-[9px] font-bold tracking-[.2em] text-gold">RUN-TIME SHEET</span>
        </div>
        <h4 class="mb-1 mt-0 text-[20px] font-extrabold tracking-[-.02em] text-[#111]">What it runs.</h4>
        <p class="mb-[18px] mt-0 text-[11px] text-[#777]">Bench tested in Middletown, February.</p>
        <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-2 border-b border-[#eee] py-[9px] text-[9px] font-bold uppercase tracking-[.12em] text-[#999]">
          <span>Tool</span><span>10 kWh</span><span>20 kWh</span>
        </div>
        {runSheet.map((r) => (
          <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-2 border-b border-[#eee] py-[9px] text-[11px] text-[#333]">
            <span>{r.tool}</span>
            <i class="mt-[3px] block h-[7px] rounded bg-[#E7E5E1]" style={`width:${r.a}%`}></i>
            <i class="mt-[3px] block h-[7px] rounded bg-gold" style={`width:${r.b}%`}></i>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
