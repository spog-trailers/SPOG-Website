---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
---
<section id="cta" class="relative overflow-hidden border-t border-line bg-black pb-[110px] pt-[120px]">
  <div class="wrap relative z-[3] grid grid-cols-[1fr_auto] items-end gap-10 max-[860px]:grid-cols-[repeat(1,1fr)]">
    <div>
      <Eyebrow gold="2027 Launch Edition" />
      <h2 class="mb-0 mt-4 text-[clamp(48px,7vw,120px)] font-black uppercase leading-[.84] tracking-[-.05em] text-white">Five slots.<br />Claim one.</h2>
      <div class="mt-[34px] flex gap-2.5" aria-label="Five build slots">
        {Array.from({ length: 5 }).map(() => <i class="block size-4 rounded-full border-2 border-gold"></i>)}
      </div>
    </div>
    <Button href="#" variant="gold" arrow>Reserve with a deposit</Button>
  </div>
</section>
