---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import Problem from '../components/sections/Problem.astro';
import Statement from '../components/sections/Statement.astro';
import ReviewQuote from '../components/sections/ReviewQuote.astro';
import UseCaseTabs from '../components/sections/UseCaseTabs.astro';
import Compare from '../components/sections/Compare.astro';
import CustomerStory from '../components/sections/CustomerStory.astro';
import Highlights from '../components/sections/Highlights.astro';
import Explore from '../components/sections/Explore.astro';
import KeyNumbers from '../components/sections/KeyNumbers.astro';
import Guarantee from '../components/sections/Guarantee.astro';
import Built from '../components/sections/Built.astro';
import Process from '../components/sections/Process.astro';
import LeadMagnet from '../components/sections/LeadMagnet.astro';
import LaunchCta from '../components/sections/LaunchCta.astro';
import Footer from '../components/sections/Footer.astro';
---
<!--
  Section rhythm rule: never put two photo-background sections next to each other.
  Photo: Hero, Statement, CustomerStory, Explore, Built
  Light: Problem, UseCaseTabs, Highlights, Guarantee, LeadMagnet
  Dark:  SocialProof, ReviewQuote, Compare, KeyNumbers, Process, LaunchCta
-->
<Base>
  <Nav />
  <Hero />
  <SocialProof />
  <Problem />
  <Statement />
  <ReviewQuote />
  <UseCaseTabs />
  <Compare />
  <CustomerStory />
  <Highlights />
  <Explore />
  <KeyNumbers />
  <Guarantee />
  <Built />
  <Process />
  <LeadMagnet />
  <LaunchCta />
  <Footer />
</Base>
