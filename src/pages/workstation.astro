---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import ProductSubnav from '../components/product/ProductSubnav.astro';
import WorkHero from '../components/work/WorkHero.astro';
import FeatureCards from '../components/features/FeatureCards.astro';
import WorkEquation from '../components/work/WorkEquation.astro';
import WorkOptions from '../components/work/WorkOptions.astro';
import WorkPhoto from '../components/work/WorkPhoto.astro';
import ProductPower from '../components/product/ProductPower.astro';
import ProductSize from '../components/product/ProductSize.astro';
import WorkRemote from '../components/work/WorkRemote.astro';
import Close from '../components/sections/Close.astro';
import Faq from '../components/sections/Faq.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { productFaqs } from '../data/productPages';
import { ws, page, close, subnavLinks, features, featuresHead, showcase, statement } from '../data/workstationPage';
---
<!--
  WORKSTATION PAGE (2026-11-17). Written for general contractors and subs. Its own page,
  replacing the shared product template for Workstation (Nate liked the draft more). The old
  draft URL /test-workstation redirects here (astro.config.mjs).
  Research: docs/product-page-teardown-workstation-2026-11-17.md (Ring, Cybertruck, Rivian R2 and R1S).
  Copy and its approval status live in src/data/workstationPage.ts.

  The work look (shared with Cargo later): heavy uppercase type, warm daylight, light
  sections with a lot of space for the pitch (Ring), one dark chapter for the numbers (Cybertruck).

  Order and rhythm (never two photo sections next to each other):
    Hero P (drone video), Feature cards L (white), Showcase P (navy Workstation in the shop),
    What it replaces L (stone), Options L (white, big photo rows), Power D,
    Statement P ("Powering the Builders of America."), Size + Specs D,
    Remote office L (stone, big photo), Close D, FAQ L, Footer D
  Photos run big, as on the reference pages (Nate, 2026-11-17), for the product, the
  features and the add-ons.
  The feature cards follow Rivian's "Get to know", Tesla's "Meet Model Y" and Pebble's feature
  section (2026-11-17). They replaced the Ring-style outcome row and the Inside section.

  Keep the ids top, cta, walkthrough, sheet and faq so Nav, Subnav, MobileBar and Close work.
-->
<Base title={ws.title} description={ws.description}>
  <Nav />
  <ProductSubnav page={page} links={subnavLinks} />
  <WorkHero />
  <FeatureCards id="overview" label="Get to know Workstation" kicker={featuresHead.kicker} heading={featuresHead.heading} features={features} look="work" tone="light" />
  <WorkPhoto image={showcase.image} alt={showcase.alt} position={showcase.position} caption={showcase.caption} />
  <WorkEquation />
  <WorkOptions />
  <ProductPower page={page} look="work" />
  <WorkPhoto image={statement.image} alt={statement.alt} position={statement.position} heading={statement.heading} align="top" />
  <ProductSize page={page} look="work" />
  <WorkRemote />
  <Close trailer="Workstation" heading={close} />
  <Faq items={productFaqs} heading="Questions crews ask." />
  <Footer />
  <MobileBar />
</Base>
