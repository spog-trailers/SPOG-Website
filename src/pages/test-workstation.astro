---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import ProductSubnav from '../components/product/ProductSubnav.astro';
import WorkHero from '../components/work/WorkHero.astro';
import WorkOutcomes from '../components/work/WorkOutcomes.astro';
import WorkEquation from '../components/work/WorkEquation.astro';
import WorkInside from '../components/work/WorkInside.astro';
import ProductPower from '../components/product/ProductPower.astro';
import ProductSize from '../components/product/ProductSize.astro';
import WorkRemote from '../components/work/WorkRemote.astro';
import Close from '../components/sections/Close.astro';
import Faq from '../components/sections/Faq.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { productFaqs } from '../data/productPages';
import { ws, page, close, subnavLinks } from '../data/workstationPage';
---
<!--
  WORKSTATION PAGE DRAFT (2026-11-17). Written for general contractors and subs.
  The live /workstation page (shared template) is untouched. Not indexed.
  Research: docs/product-page-teardown-workstation-2026-11-17.md (Ring, Cybertruck, Rivian R2 and R1S).
  Copy and its approval status live in src/data/workstationPage.ts.

  The work look (shared with Cargo later): heavy uppercase type, warm daylight, mostly light
  sections with a lot of space (Ring), one dark chapter for the numbers (Cybertruck).

  Order and rhythm (never two photo sections next to each other):
    Hero P, Outcomes L (white), What it replaces L (stone), Inside L (white),
    Power D, Size + Specs D, Remote office L (stone), Close D, FAQ L, Footer D

  Keep the ids top, cta, walkthrough, sheet and faq so Nav, Subnav, MobileBar and Close work.
-->
<Base title={ws.title} description={ws.description} noindex>
  <Nav />
  <ProductSubnav page={page} links={subnavLinks} />
  <WorkHero />
  <WorkOutcomes />
  <WorkEquation />
  <WorkInside />
  <ProductPower page={page} look="work" />
  <ProductSize page={page} look="work" />
  <WorkRemote />
  <Close trailer="Workstation" heading={close} />
  <Faq items={productFaqs} heading="Questions crews ask." />
  <Footer />
  <MobileBar />
</Base>
