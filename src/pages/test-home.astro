---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import TestHero from '../components/test-home/TestHero.astro';
import LineupCards from '../components/test-home/LineupCards.astro';
import FeatureCards from '../components/features/FeatureCards.astro';
import Built from '../components/sections/Built.astro';
import Close from '../components/sections/Close.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { hero, values, valuesHead } from '../data/testHome';
import { shoot } from '../data/content';
---
<!--
  TEST HOMEPAGE v2 (draft, 2026-11-17). The live homepage at / is untouched. Not indexed.
  Copy and its approval status live in src/data/testHome.ts.

  After Nate's review of v1 ("everything is competing for my attention"), the homepage only
  does two things. It shows every trailer once, Tesla style, and it says what all of them
  share (power, freedom, utility, quality, American made). Feature selling lives on the
  product pages, each with its own look.

  Order and rhythm (never two photo sections next to each other):
    Hero P, Lineup cards L, Values D (feature cards), Built P, Close D
  The values are feature cards after Rivian, Tesla and Pebble (2026-11-17), replacing the five text pillars.

  Held, not rendered (v1 showcases, kept as starting points for the product pages):
    ShowCargo, ShowWorkstation, ShowEvent, ShowGarage, ShowRelief, ShowCamper, SpecPlate.
    Nate liked the Garage and Disaster Relief looks.

  Keep the ids top, cta, walkthrough and sheet so Nav, MobileBar and Close work.
-->
<Base title="Test homepage | SPOG Trailers" noindex>
  <Nav />
  <TestHero />
  <LineupCards />
  <FeatureCards id="values" label="What every SPOG is built on" kicker={valuesHead.kicker} heading={valuesHead.heading} features={values} tone="dark" />
  <Built image={shoot.wsFlagShop} position="62% 50%" />
  <Close heading={hero.heading as [string, string]} />
  <Footer />
  <MobileBar />
</Base>
