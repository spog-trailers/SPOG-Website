---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import ProductSubnav from '../components/product/ProductSubnav.astro';
import ProductPower from '../components/product/ProductPower.astro';
import Cargo2Tour from '../components/cargo2/Cargo2Tour.astro';
import Cargo2Specs from '../components/cargo2/Cargo2Specs.astro';
import Cargo2Close from '../components/cargo2/Cargo2Close.astro';
import Ws2Hero from '../components/ws2/Ws2Hero.astro';
import Ws2Features from '../components/ws2/Ws2Features.astro';
import Ws2Comfort from '../components/ws2/Ws2Comfort.astro';
import Ws2Anywhere from '../components/ws2/Ws2Anywhere.astro';
import Ws2Road from '../components/ws2/Ws2Road.astro';
import Ws2Built from '../components/ws2/Ws2Built.astro';
import Ws2Options from '../components/ws2/Ws2Options.astro';
import Ws2Case from '../components/ws2/Ws2Case.astro';
import Faq from '../components/sections/Faq.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { footerColumns } from '../data/content';
import { close, demo, design, faqs, meta, power, runtime, specs, subnavLinks, tour, tourStandIn } from '../data/workstation2Page';
// This page has no walkthrough form, so the footer's Contact link goes to the demo page.
const footer = footerColumns.map((c) => ({ ...c, links: c.links.map(([label, href]) => [label, href === '#walkthrough' ? demo.href : href]) }));
---
<!--
  WORKSTATION 2 (draft). Nate's new pass on the Workstation sales page. /workstation is untouched.
  Linked as "Workstation 2" in the nav and footer. Not indexed while it's a draft.

  v3 (2026-11-20). Nate found v1 said the same things over and over. The copy was rebuilt one-to-one
  on the Tesla Cybertruck page and approved in Notion (Company Roadmap > Website Build > "Workstation").
  Each feature is said once, in one place. Copy and its marks live in src/data/workstation2Page.ts.
  [BRACKETS] in the copy are facts Joe still has to supply. They show highlighted on purpose.

  Order, the Cybertruck section each one mirrors, and the rhythm (never two photo sections next to
  each other; sections with inset media on a plain background don't count as photo sections):
    Hero P (drone video, name, Nate's line, buttons, three numbers)          Cybertruck hero
    Redefining the site office L (stone, five swipe cards)                   Redefining the Pickup Truck
    See how it works for you L (3D tour, Cargo model as a stand-in)          Nate's call, no Cybertruck twin
    Tough on the outside, comfortable on the inside D (warm, interior video)  same section, one-to-one
    Take it anywhere L (white, Rivian clip, four cards, number row)         Take on Any Terrain
    Your office on the road L (stone, clip and words)                        The Future of Travel Is Autonomous
    Built to last on the job site D (three cards)                            Designed to Be the Safest Truck
    Add what you need L (white, option tiles)                                Add What You Need
    Power anything with Workstation D (run-time tool)                        Power Anything With Cybertruck
    Ground control for Joby Aviation P (case study band)                     Rivian Fleet's Amazon band
    Specs D, Close D, FAQ L, Footer D
  Keep the ids top, overview, tour, inside, anywhere, road, built, options, runtime, case, specs, cta
  and faq: the section bar, the phone bar and links point at them.
-->
<Base title={meta.title} description={meta.description} noindex>
  <Nav cta={design} />
  <ProductSubnav page={runtime} links={subnavLinks} buttons={[demo, design]} />
  <Ws2Hero />
  <Ws2Features />
  <Cargo2Tour tour={tour} design={design} standIn={tourStandIn} />
  <Ws2Comfort />
  <Ws2Anywhere />
  <Ws2Road />
  <Ws2Built />
  <Ws2Options />
  <ProductPower page={runtime} look="work" id="runtime" sheet={false} heading={power.heading} intro={power.intro} figures={power.figures} />
  <Ws2Case />
  <Cargo2Specs specs={specs} />
  <Cargo2Close close={close} demo={demo} design={design} />
  <Faq items={faqs} heading="Questions about Workstation." />
  <Footer columns={footer} />
  <MobileBar cta={design} />
</Base>

<script>
  // Every [data-ws2-video] on the page loads and plays only while it's on screen, and pauses when it
  // leaves. Reduced motion keeps the posters.
  const vids = [...document.querySelectorAll<HTMLVideoElement>('[data-ws2-video]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (vids.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      }
    }, { rootMargin: '200px 0px', threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
  }
</script>
