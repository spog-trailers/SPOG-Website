---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import { demo, demoNav, demoFooter } from '../data/demo';
/**
 * BOOK A DEMO (draft, 2026-11-18). "Book a demo" in the homepage nav lands here. Not indexed.
 * Three choices (Nate): an in-person demo, a virtual demo, or call now. The first two open their
 * form under the cards, and the third dials the number. Without JavaScript both forms show.
 * Light page with lots of room, in the Ring Jobsite Security spirit Nate likes, then the dark footer.
 * Copy and its approval marks live in src/data/demo.ts. Forms have no endpoint yet (GoHighLevel TODO).
 */
const field = 'w-full rounded-[10px] border border-[#d9d6d1] bg-white px-4 py-[14px] text-[16px] text-ink placeholder:text-[#9a9894] focus-visible:border-coal';
const label = 'mb-1.5 block text-[11px] font-semibold uppercase tracking-[.18em] text-ink-soft';
const send = 'col-span-full mt-2 h-[52px] cursor-pointer border-[1.5px] border-coal bg-coal text-[12px] font-bold uppercase leading-[normal] tracking-[.2em] text-white hover:border-gold hover:bg-gold hover:text-black';
const icons: Record<string, string> = {
  pin: '<path d="M17 30s-9-8.4-9-15a9 9 0 0 1 18 0c0 6.6-9 15-9 15z"/><circle cx="17" cy="15" r="3.2"/>',
  video: '<rect x="4" y="10" width="19" height="14" rx="2.5"/><path d="M23 15l7-4v12l-7-4"/>',
  phone: '<path d="M9 5h5l2.4 6-3.2 2a14 14 0 0 0 7.8 7.8l2-3.2 6 2.4v5a2.5 2.5 0 0 1-2.7 2.5C14.6 26.6 7.4 19.4 6.5 7.7A2.5 2.5 0 0 1 9 5z"/>',
};
---
<Base title="Book a demo | SPOG Trailers" description="Book an in-person or virtual demo of a SPOG trailer, or call the team." noindex>
  <Nav cta={{ label: 'Design yours', href: '/#design' }} demo={{ label: 'Book a demo', href: '/demo' }} lineupHref="/#lineup" links={demoNav} />

  <main id="top" class="bg-stone pb-[120px] pt-[190px] text-ink max-[640px]:pb-20 max-[640px]:pt-[150px]">
    <div class="wrap">
      <h1 class="m-0 text-[clamp(44px,6vw,88px)] font-semibold leading-[1] tracking-[-.04em] text-coal">{demo.heading}</h1>
      <p class="mb-0 mt-5 max-w-[560px] text-[18px] leading-[1.55] text-ink-soft">{demo.sub}</p>

      <ul class="m-0 mt-14 grid list-none grid-cols-[repeat(3,minmax(0,1fr))] gap-4 p-0 max-[900px]:grid-cols-[repeat(1,minmax(0,1fr))] max-[640px]:mt-10 max-[640px]:gap-3">
        {demo.options.map((o) => (
          <li>
            <a
              href={o.href ?? `#${o.id}`}
              data-demo-pick={o.href ? undefined : o.id}
              class="group flex h-full flex-col rounded-[18px] border-[1.5px] border-transparent bg-paper px-8 pb-8 pt-8 text-coal no-underline transition-colors hover:border-coal aria-[current=true]:border-coal max-[640px]:px-6 max-[640px]:pb-6 max-[640px]:pt-6"
            >
              <svg viewBox="0 0 34 34" class="size-9 fill-none stroke-coal stroke-[1.5]" aria-hidden="true" set:html={icons[o.icon]} />
              <span class="mt-10 block text-[clamp(22px,2vw,28px)] font-semibold leading-[1.15] tracking-[-.025em] max-[900px]:mt-6">{o.title}</span>
              <span class="mt-3 block flex-1 text-[16px] leading-[1.55] text-ink-soft">{o.body}</span>
              <span class:list={[
                'mt-8 inline-flex h-[46px] items-center justify-center gap-3 self-start border-[1.5px] px-[22px] text-[11.5px] font-bold uppercase leading-[normal] tracking-[.2em] max-[640px]:mt-6',
                o.href ? 'border-gold bg-gold text-black group-hover:border-coal group-hover:bg-coal group-hover:text-white' : 'border-coal text-coal group-hover:bg-coal group-hover:text-white',
              ]}>
                {o.cta}
                <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      {(['in-person', 'virtual'] as const).map((id) => {
        const f = demo.forms[id];
        return (
          <section id={id} data-demo-form={id} aria-label={f.title} class="mt-4 scroll-mt-[120px] rounded-[18px] bg-paper px-10 pb-10 pt-9 max-[640px]:px-6 max-[640px]:pb-7 max-[640px]:pt-7">
            <h2 class="m-0 text-[30px] font-semibold leading-[1.1] tracking-[-.025em] text-coal">{f.title}</h2>
            <p class="mb-0 mt-2.5 text-[16.5px] text-ink-soft">{f.body}</p>
            <!-- TODO: connect this form to GoHighLevel. Read the GoHighLevel SOP in Notion first. -->
            <form class="mt-7 grid grid-cols-[repeat(2,1fr)] gap-x-3 gap-y-4 max-[640px]:grid-cols-[repeat(1,1fr)]" onsubmit="return false">
              <div><label for={`${id}-name`} class={label}>Name</label><input id={`${id}-name`} name="name" autocomplete="name" class={field} /></div>
              <div><label for={`${id}-company`} class={label}>Company</label><input id={`${id}-company`} name="company" autocomplete="organization" class={field} /></div>
              <div><label for={`${id}-email`} class={label}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" class={field} /></div>
              <div><label for={`${id}-phone`} class={label}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" class={field} /></div>
              <div>
                <label for={`${id}-trailer`} class={label}>Trailer</label>
                <select id={`${id}-trailer`} name="trailer" class={`${field} cursor-pointer`}>
                  {demo.trailers.map((t) => <option>{t}</option>)}
                </select>
              </div>
              {id === 'in-person' ? (
                <div><label for={`${id}-town`} class={label}>{demo.forms['in-person'].place}</label><input id={`${id}-town`} name="town" autocomplete="postal-code" class={field} /></div>
              ) : (
                <div><label for={`${id}-when`} class={label}>{demo.when}</label><input id={`${id}-when`} name="when" class={field} /></div>
              )}
              {id === 'in-person' && (
                <div class="col-span-full"><label for={`${id}-when`} class={label}>{demo.when}</label><input id={`${id}-when`} name="when" class={field} /></div>
              )}
              <button type="button" class={send}>{f.cta}</button>
            </form>
          </section>
        );
      })}
    </div>
  </main>

  <Footer columns={demoFooter} full />
</Base>

<script>
  // The two booking cards open their form under the row. The call card is a plain phone link.
  const picks = [...document.querySelectorAll<HTMLAnchorElement>('[data-demo-pick]')];
  const forms = [...document.querySelectorAll<HTMLElement>('[data-demo-form]')];
  const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
  const show = (id: string | null, scroll = false) => {
    forms.forEach((f) => (f.hidden = f.dataset.demoForm !== id));
    picks.forEach((p) => p.setAttribute('aria-current', String(p.dataset.demoPick === id)));
    const form = forms.find((f) => f.dataset.demoForm === id);
    if (form && scroll) form.scrollIntoView({ behavior: smooth, block: 'start' });
  };
  picks.forEach((p) => p.addEventListener('click', (e) => {
    e.preventDefault();
    history.replaceState(null, '', `#${p.dataset.demoPick}`);
    show(p.dataset.demoPick ?? null, true);
  }));
  const start = location.hash.slice(1);
  show(forms.some((f) => f.dataset.demoForm === start) ? start : null);
</script>
