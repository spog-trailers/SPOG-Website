---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import TestHero from '../components/test-home/TestHero.astro';
import ProofStrip from '../components/home2/ProofStrip.astro';
import LineupScroll from '../components/home2/LineupScroll.astro';
import ProblemCards from '../components/home2/ProblemCards.astro';
import FeatureCards from '../components/features/FeatureCards.astro';
import AboutBand from '../components/home2/AboutBand.astro';
import CloseForms from '../components/home2/CloseForms.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { hero, madeOf, values, footerColumns } from '../data/home2';
---
<!--
  TEST HOMEPAGE 2 (draft, 2026-11-18). The live homepage at / and /test-home are untouched. Not indexed.
  Copy and its approval status live in src/data/home2.ts. It comes from the "Home Page" item
  under Website Build in Notion's Company Roadmap, as Nate left it after the 2026-11-18 call.

  What changed from /test-home: only Cargo, Workstation and Event get space (about 75% of the
  page speaks to contractors), and Garage, Disaster Relief and Camper shrink to one strip.

  Order and rhythm (never two photo sections next to each other):
    Hero P (background video), Proof strip D (thin), Lineup L L D (sticky scroll, Event at night)
    with the Coming next strip D, Problem L (three cards), What SPOG is made of D (feature cards),
    About P, Close D
  Cut at Nate's call: Built different, Guarantee, How it works and the run-time sheet.

  Kept from /test-home because Nate likes them: the hero look, the feature cards and the Built band.
  Keep the ids top, cta, design and walkthrough so Nav, MobileBar, the lineup and the close work.
-->
<Base title="Test homepage 2 | SPOG Trailers" noindex>
  <Nav cta={{ small: '2027 lineup', label: 'Design yours', href: '#design' }} lineupHref="#lineup" />
  <TestHero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    sub={hero.sub}
    primary={hero.primary}
    secondary={hero.secondary}
    size="text-[clamp(40px,8.4vw,138px)]"
  />
  <ProofStrip />
  <LineupScroll />
  <ProblemCards />
  <FeatureCards id="values" label={madeOf.label} kicker="" heading={madeOf.heading} features={values} tone="dark">
    <p slot="kicker" aria-label={`SPOG stands for ${madeOf.stands.join(' ')}`} class="m-0 flex flex-wrap items-center gap-x-[1.2em] gap-y-1 text-[11.5px] font-semibold uppercase tracking-[.24em] text-mute">
      {madeOf.stands.map((w) => <span aria-hidden="true"><b class="font-black text-gold">{w[0]}</b>{w.slice(1)}</span>)}
    </p>
  </FeatureCards>
  <AboutBand />
  <CloseForms />
  <Footer columns={footerColumns} full />
  <MobileBar cta={{ label: 'Design yours', href: '#design' }} />
</Base>
