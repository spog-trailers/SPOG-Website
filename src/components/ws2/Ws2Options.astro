---
import Icon from '../ui/Icon.astro';
import WorkTitle from '../work/WorkTitle.astro';
import { options } from '../../data/workstation2Page';
/**
 * "Add what you need.", after Cybertruck's accessories grid. Light gray tiles with a thin line icon,
 * the option's name and one full sentence (Tesla's tile look from the design language). The security
 * options live in the "Lock down the site" card, so they aren't repeated here.
 */
---
<section id="options" aria-label="Add what you need" class="bg-white pb-[120px] pt-[130px] text-ink max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <div class="max-w-[980px]">
      <WorkTitle lines={options.heading} />
      <p class="mb-0 mt-6 max-w-[640px] t-body text-ink-soft">{options.sub}</p>
    </div>
    <ul class="m-0 mt-14 grid list-none grid-cols-[repeat(4,minmax(0,1fr))] gap-4 p-0 max-[1100px]:grid-cols-[repeat(2,minmax(0,1fr))] max-[560px]:grid-cols-[minmax(0,1fr)] max-[640px]:mt-10">
      {options.items.map((o) => (
        <li class="rounded-[16px] bg-stone px-7 pb-8 pt-7">
          <Icon name={o.icon} class="size-8 stroke-coal stroke-[1.4]" />
          <h3 class="m-0 mt-6 t-h3 text-coal">{o.name}</h3>
          <p class="mb-0 mt-2 t-body-sm text-ink-soft">{o.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
