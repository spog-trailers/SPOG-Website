---
/**
 * Copy text with its [BRACKET] gaps marked. Gaps are facts Joe still has to supply. They show on the
 * draft on purpose, highlighted so nobody mistakes them for finished copy. Fill the fact in the
 * page's data file and the highlight goes away by itself. /workstation-2 has none left after the
 * 2026-11-20 price sheet (the certifications are held in a comment until the NATM inspection passes).
 */
interface Props { text: string }
const parts = Astro.props.text.split(/(\[[^\]]+\])/);
---
{parts.map((p) => (p.startsWith('[') && p.endsWith(']') ? <span class="ws2-gap">{p}</span> : p))}

<style is:global>
  .ws2-gap { padding: 0 .2em; border-bottom: 1.5px dashed currentColor; border-radius: 3px; background: rgb(238 161 20 / .2); }
</style>
