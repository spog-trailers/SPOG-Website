---
import { built } from '../../data/workstation2Page';
/**
 * Built and serviced, after Semi's "Service Your Fleet": who builds it and who shows up when
 * something needs work, set over Nate's shop fly-through. Only the facts already confirmed for
 * Cargo 2 (the Warranty Policy and Nate). The video loads and plays only while the band is on
 * screen; the poster stays for reduced motion.
 */
---
<section id="built" aria-label="Built and serviced by SPOG" class="grain relative flex min-h-[86vh] items-end overflow-hidden bg-night pb-20 pt-40 text-white max-[640px]:min-h-[80svh] max-[640px]:pb-14 max-[640px]:pt-28">
  <video data-ws2-video src={built.video} poster={built.poster} muted loop playsinline preload="none" aria-label="Flying through the SPOG shop in Middletown, New York, past a welder at work" class="absolute inset-0 size-full object-cover brightness-[.62] saturate-[.9]"></video>
  <div class="absolute inset-0 z-[1] bg-[linear-gradient(to_top,rgb(0_0_0/.88)_0%,rgb(0_0_0/.45)_40%,rgb(0_0_0/.1)_70%),linear-gradient(to_bottom,#0a0a0b_0%,rgb(10_10_11/0)_18%)]"></div>

  <div class="wrap relative z-[3] w-full">
    <h2 class="m-0 max-w-[900px] t-h1">
      {built.heading.map((l, i) => <Fragment>{i > 0 && <Fragment><br class="max-[640px]:hidden" /><span class="min-[641px]:hidden"> </span></Fragment>}{l}</Fragment>)}
    </h2>
    <p class="mb-0 mt-6 max-w-[560px] t-body text-white/80">{built.body}</p>
    <dl class="m-0 mt-12 grid grid-cols-[repeat(3,minmax(0,1fr))] border-t border-white/25 max-[640px]:mt-9 max-[640px]:grid-cols-[minmax(0,1fr)]">
      {built.stats.map(([v, k]) => (
        <div class="flex flex-col-reverse gap-2 pt-6 not-first:border-l not-first:border-white/20 not-first:pl-10 max-[640px]:flex-row-reverse max-[640px]:items-baseline max-[640px]:justify-between max-[640px]:py-4 max-[640px]:not-first:border-l-0 max-[640px]:not-first:border-t max-[640px]:not-first:pl-0">
          <dt class="t-label text-white/65">{k}</dt>
          <dd class="m-0 t-h2 normal-case">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  // Shared by every [data-ws2-video] on the page (this band and the mobile office card).
  const vids = [...document.querySelectorAll<HTMLVideoElement>('[data-ws2-video]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (vids.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      }
    }, { rootMargin: '200px 0px' });
    vids.forEach((v) => io.observe(v));
  }
</script>
