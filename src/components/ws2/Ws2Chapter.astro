---
import WorkTitle from '../work/WorkTitle.astro';
import { srcset } from '../../data/content';
/**
 * One chapter of the Workstation 2 page, after Cybertruck and Model S: a heading, one paragraph,
 * big rounded inset media on a plain background, and sometimes a stat row with thin dividers.
 * The media never runs full bleed, so chapters can sit next to each other without breaking the
 * "no two photo sections in a row" rule.
 *
 * layout
 *   wide   one 16:9 photo across the page, stats under it (Power)
 *   pair   two photos side by side, the first wider, a caption under each (Security)
 *   split  photo on the left, the words on the right (Internet)
 */
type Media = { src: string; alt: string; position?: string; caption?: string };
interface Props {
  id: string;
  label: string;
  heading: string[];
  body: string;
  layout: 'wide' | 'pair' | 'split';
  media: Media[];
  stats?: [string, string][];
  note?: string;
  tone?: 'white' | 'stone';
}
const { id, label, heading, body, layout, media, stats, note, tone = 'white' } = Astro.props;
const bg = tone === 'stone' ? 'bg-stone' : 'bg-white';
const img = 'block w-full rounded-[22px] bg-stone-2 object-cover';
---
<section id={id} aria-label={label} class:list={[bg, 'pb-[120px] pt-[130px] text-ink max-[640px]:pb-16 max-[640px]:pt-20']}>
  <div class="wrap">
    {layout === 'split' ? (
      <div class="grid grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] items-center gap-x-16 gap-y-10 max-[900px]:grid-cols-[minmax(0,1fr)]">
        <img src={media[0].src} srcset={srcset(media[0].src)} sizes="(max-width: 900px) 100vw, 720px" alt={media[0].alt} loading="lazy" class:list={[img, 'aspect-[4/3]']} style={`object-position:${media[0].position ?? '50% 50%'}`} />
        <div>
          <WorkTitle lines={heading} />
          <p class="mb-0 mt-6 max-w-[480px] t-body text-ink-soft">{body}</p>
          {note && <p class="mb-0 mt-5 t-fine text-ink-soft">{note}</p>}
        </div>
      </div>
    ) : (
      <Fragment>
        <div class="max-w-[980px]">
          <WorkTitle lines={heading} />
          <p class="mb-0 mt-6 max-w-[620px] t-body text-ink-soft">{body}</p>
        </div>

        {layout === 'wide' && (
          <img src={media[0].src} srcset={srcset(media[0].src)} sizes="(max-width: 1392px) 100vw, 1248px" alt={media[0].alt} loading="lazy" class:list={[img, 'mt-14 aspect-[16/9] max-[640px]:mt-10 max-[640px]:aspect-[4/3]']} style={`object-position:${media[0].position ?? '50% 50%'}`} />
        )}

        {layout === 'pair' && (
          <div class="mt-14 grid grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-4 max-[640px]:mt-10 max-[640px]:grid-cols-[minmax(0,1fr)] max-[640px]:gap-8">
            {media.map((m) => (
              <figure class="m-0">
                <img src={m.src} srcset={srcset(m.src)} sizes="(max-width: 640px) 100vw, 720px" alt={m.alt} loading="lazy" class:list={[img, 'h-[clamp(380px,46vw,680px)] max-[640px]:h-auto max-[640px]:aspect-[4/5]']} style={`object-position:${m.position ?? '50% 50%'}`} />
                {m.caption && <figcaption class="mt-3 t-label text-ink-soft">{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </Fragment>
    )}

    {stats && (
      <dl class="m-0 mt-12 grid grid-cols-[repeat(3,minmax(0,1fr))] border-t border-stone-2 max-[640px]:mt-8 max-[640px]:grid-cols-[minmax(0,1fr)]">
        {stats.map(([v, k]) => (
          <div class="flex flex-col-reverse gap-2 pt-7 not-first:border-l not-first:border-stone-2 not-first:pl-10 max-[640px]:flex-row-reverse max-[640px]:items-baseline max-[640px]:justify-between max-[640px]:py-5 max-[640px]:not-first:border-l-0 max-[640px]:not-first:border-t max-[640px]:not-first:pl-0">
            <dt class="t-label text-ink-soft">{k}</dt>
            <dd class="m-0 t-h2 normal-case text-coal">{v}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
