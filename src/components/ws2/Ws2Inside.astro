---
import WorkTitle from '../work/WorkTitle.astro';
import { srcset } from '../../data/content';
import { inside } from '../../data/workstation2Page';
/**
 * Inside, the page's one dark, warm chapter, after Model S's interior chapter and R2's named
 * interiors. It comes after power, security and internet on purpose: the messaging report says
 * to lead with what's running and use the finish as reassurance that it's a real office.
 * The two photos are two real builds (different trailers, different layouts), so they sit side by
 * side with their finish names instead of acting as a finish switch.
 * When the Workstation 360 shoot exists, the 3D interior goes here, above the two builds.
 */
---
<section id="inside" aria-label="Inside the Workstation" class="ws2-inside pb-[130px] pt-[140px] text-bone max-[640px]:pb-20 max-[640px]:pt-24">
  <div class="wrap">
    <div class="max-w-[980px]">
      <WorkTitle lines={inside.heading} tone="dark" />
      <p class="mb-0 mt-6 max-w-[620px] t-body text-bone/75">{inside.body}</p>
    </div>

    <div class="mt-14 grid grid-cols-[repeat(2,minmax(0,1fr))] gap-5 max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:gap-12 max-[640px]:mt-10">
      {inside.builds.map((b) => (
        <article>
          <img src={b.src} srcset={srcset(b.src)} sizes="(max-width: 900px) 100vw, 640px" alt={b.alt} loading="lazy" class="block aspect-[4/3] w-full rounded-[22px] bg-panel object-cover" style={`object-position:${b.position}`} />
          <h3 class="m-0 mt-6 t-h3 text-white">{b.name}</h3>
          <p class="mb-0 mt-2 max-w-[520px] t-body-sm text-bone/70">{b.body}</p>
        </article>
      ))}
    </div>
    <p class="mb-0 mt-12 t-fine text-mute">{inside.fine}</p>
  </div>
</section>

<style>
  /* Warm night, a half step up from the plain black chapters, so the wood and the lighting read rich. */
  .ws2-inside { background: radial-gradient(ellipse 90% 70% at 70% 0%, #1d1a16 0%, #0d0c0b 60%, #0a0a0b 100%); }
</style>
