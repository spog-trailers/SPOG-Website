---
import Ws2Media from './Ws2Media.astro';
import WorkTitle from '../work/WorkTitle.astro';
import { road } from '../../data/workstation2Page';
/**
 * "Your office on the road.", the one section for the second buyer (creators, consultants, digital
 * nomads), in the slot where Cybertruck puts "The Future of Travel Is Autonomous". The clip is
 * someone at work at the desk, seen from behind, from Nate's interior footage.
 */
---
<section id="road" aria-label="Your office on the road" class="bg-stone pb-[120px] pt-[130px] text-ink max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-center gap-x-16 gap-y-10 max-[900px]:grid-cols-[minmax(0,1fr)]">
    <Ws2Media media={road.media} class="block aspect-[4/3] w-full rounded-[22px] bg-stone-2 object-cover" />
    <div>
      <WorkTitle lines={road.heading} />
      <p class="mb-0 mt-6 max-w-[500px] t-body text-ink-soft">{road.body}</p>
    </div>
  </div>
</section>
