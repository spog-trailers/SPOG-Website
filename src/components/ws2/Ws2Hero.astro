---
import { demo, design, hero } from '../../data/workstation2Page';
/**
 * Workstation 2 hero, after Cybertruck: Nate's drone loop full bleed, the name set huge, one line,
 * the two buttons, and the three facts a GC asks about first along the bottom with thin dividers.
 * The price line ("Starting at $18,500", Nate 2026-11-20) shows whenever hero.price is set in
 * workstation2Page.ts. The tax, title, registration and delivery fine print sits under the specs.
 * Keep the id "top": the section bar and the phone action bar watch it.
 */
const btn = 'inline-flex h-[50px] items-center justify-center border-[1.5px] px-7 t-btn no-underline transition-colors';
---
<header id="top" class="grain relative flex min-h-[max(100svh,720px)] items-end overflow-hidden bg-night text-white max-[640px]:min-h-[100svh]">
  <video
    class="absolute inset-0 size-full object-cover object-[50%_55%] brightness-[.72] contrast-[1.06]"
    autoplay muted loop playsinline preload="metadata" poster={hero.poster} aria-label={hero.alt} data-ws2-hero-video
  >
    <source src={hero.video} type="video/mp4" />
  </video>
  <div class="absolute inset-0 z-[1] bg-[linear-gradient(to_top,rgb(0_0_0/.88)_0%,rgb(0_0_0/.5)_34%,rgb(0_0_0/0)_62%),linear-gradient(to_bottom,rgb(0_0_0/.45)_0%,rgb(0_0_0/0)_22%)]"></div>

  <div class="wrap relative z-[3] w-full pb-14 pt-[150px] @container max-[640px]:pb-10 max-[640px]:pt-[130px]">
    <h1 class="m-0 t-display" style="font-size:min(clamp(80px, calc(56.2px + 6.1vw), 144px), 12.1cqw)">{hero.name}</h1>
    <div class="mt-7 flex items-end justify-between gap-10 max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-7">
      <p class="m-0 max-w-[620px] t-lead">{hero.line}</p>
      <div class="flex shrink-0 gap-2.5 max-[420px]:w-full max-[420px]:flex-col">
        <a href={demo.href} class={`${btn} border-white/75 bg-black/25 text-white backdrop-blur-[6px] hover:border-white hover:bg-white hover:text-black`}>{demo.label}</a>
        <a href={design.href} class={`${btn} border-gold bg-gold text-black hover:border-white hover:bg-white`}>{design.label}</a>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-6 border-t border-white/20 pt-6 max-[640px]:mt-8">
      <dl class="m-0 flex flex-wrap gap-y-5">
        {hero.stats.map(([k, v]) => (
          <div class="flex flex-col-reverse gap-1.5 pr-8 not-first:border-l not-first:border-white/20 not-first:pl-8 max-[640px]:w-full max-[640px]:flex-row-reverse max-[640px]:justify-between max-[640px]:border-l-0! max-[640px]:pl-0! max-[640px]:pr-0">
            <dt class="t-label text-white/65">{k}</dt>
            <dd class="m-0 t-h3">{v}</dd>
          </div>
        ))}
      </dl>
      {hero.price && <p class="m-0 t-lead">{hero.price}</p>}
    </div>
  </div>
</header>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-ws2-hero-video]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
