---
import { phone } from '../../data/content';
import { close, demo, design } from '../../data/cargo2Page';
/**
 * The close: the promise once more and the two ways forward. Keeps the id "cta", which the phone
 * action bar watches so it doesn't sit on top of these buttons.
 */
const btn = 'inline-flex h-[54px] items-center justify-center border-[1.5px] px-8 text-[12px] font-bold uppercase leading-[normal] tracking-[.18em] no-underline transition-colors';
---
<section id="cta" aria-label="Design yours or book a demo" class="border-t border-line bg-black pb-[130px] pt-[140px] text-center text-bone max-[640px]:pb-20 max-[640px]:pt-24">
  <div class="wrap flex flex-col items-center">
    <h2 class="m-0 max-w-[1000px] text-[clamp(40px,6vw,92px)] font-black uppercase leading-[.9] tracking-[0em] text-white">{close.heading}</h2>
    <p class="mb-0 mt-7 max-w-[520px] text-[18px] leading-[1.6] text-bone/78">{close.body}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3 max-[420px]:w-full max-[420px]:flex-col">
      <a href={design.href} class={`${btn} border-gold bg-gold text-black hover:border-white hover:bg-white`}>{design.label}</a>
      <a href={demo.href} class={`${btn} border-white/70 text-white hover:border-white hover:bg-white hover:text-black`}>{demo.label}</a>
    </div>
    <a href={phone.href} class="mt-7 text-[15px] font-semibold text-bone/80 underline underline-offset-[5px] hover:text-white">Or call {phone.display}</a>
  </div>
</section>
