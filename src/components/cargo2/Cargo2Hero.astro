---
import { srcset } from '../../data/content';
import { demo, design, hero } from '../../data/cargo2Page';
/**
 * Cargo 2 hero, after the Rivian R1T page: the real photo full bleed, the name set huge at the
 * bottom left with the promise under it, the two buttons at the bottom right, and the starting price (Nate, 2026-11-19, after Rivian).
 * The photo is the finished black 20 ft outside the SPOG shop (source photo 13).
 * Keep the id "top": the section bar and the phone action bar watch it.
 */
const btn = 'inline-flex h-[50px] items-center justify-center border-[1.5px] px-7 text-[12px] font-bold uppercase leading-[normal] tracking-[.18em] no-underline transition-colors';
---
<header id="top" class="grain relative flex h-[100svh] min-h-[720px] items-end overflow-hidden bg-night text-white max-[640px]:min-h-[640px]">
  <img src={hero.image} srcset={srcset(hero.image)} sizes="100vw" alt={hero.alt} fetchpriority="high" class="absolute inset-0 size-full object-cover object-[50%_40%] max-[640px]:object-[56%_38%]" />
  <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(0_0_0/.86)_0%,rgb(0_0_0/.5)_30%,rgb(0_0_0/0)_58%),linear-gradient(to_bottom,rgb(0_0_0/.38)_0%,rgb(0_0_0/0)_22%)]"></div>

  <div class="wrap relative z-[3] w-full pb-14 max-[640px]:pb-10">
    <div class="flex items-end justify-between gap-10 max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-7">
      <div class="max-w-[760px]">
        <h1 class="m-0">
          <span class="block text-[clamp(84px,13vw,210px)] font-black uppercase leading-[.8] tracking-[-.06em]">{hero.name}</span>
          <span class="mt-4 block text-[clamp(17px,1.5vw,21px)] font-semibold tracking-[-.01em] text-white/80">{hero.type}</span>
        </h1>
        <p class="mb-0 mt-5 text-[clamp(21px,2vw,28px)] font-semibold leading-[1.25] tracking-[-.02em]">{hero.line}</p>
        <p class="mb-0 mt-3 max-w-[600px] text-[16.5px] leading-[1.55] text-white/78 max-[640px]:text-[15px]">{hero.sub}</p>
      </div>
      <div class="flex shrink-0 gap-2.5 max-[420px]:w-full max-[420px]:flex-col">
        <a href={demo.href} class={`${btn} border-white/75 bg-black/25 text-white backdrop-blur-[6px] hover:border-white hover:bg-white hover:text-black`}>{demo.label}</a>
        <a href={design.href} class={`${btn} border-gold bg-gold text-black hover:border-white hover:bg-white`}>{design.label}</a>
      </div>
    </div>
    <p class="mb-0 mt-10 border-t border-white/20 pt-6 text-[clamp(18px,1.6vw,22px)] font-semibold tracking-[-.02em] max-[640px]:mt-8">{hero.price}</p>
  </div>
</header>
