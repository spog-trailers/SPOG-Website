---
import WorkTitle from '../work/WorkTitle.astro';
import { small } from '../../data/content';
import { build } from '../../data/cargo2Page';
/**
 * Built for the job site (Nate, 2026-11-19). Cargo is a utility trailer first, and GCs and subs
 * want to know it holds up. The welded steel frame leads, then six build facts, every one from
 * the options sheet, the Warranty Policy, the Objections & FAQ doc or Nate. No toughness claims
 * beyond those, because every claim on the site reads as a promise.
 * Photos: the welding shot shows the steel frame going together. Swap in Nate's frame photos
 * when they arrive (he offered more on 2026-11-19).
 */
---
<section id="build" aria-label="Built for the job site" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-end gap-x-16 gap-y-7 max-[960px]:grid-cols-[minmax(0,1fr)]">
      <WorkTitle lines={build.heading} tone="dark" />
      <p class="m-0 max-w-[560px] text-[18px] leading-[1.6] text-bone/80">{build.body}</p>
    </div>

    <div class="mt-14 grid grid-cols-[repeat(2,minmax(0,1fr))] gap-3 max-[760px]:grid-cols-[minmax(0,1fr)] max-[640px]:mt-10">
      {build.photos.map((p) => (
        <figure class="m-0">
          <img src={small(p.src)} alt={p.alt} loading="lazy" class="block aspect-[3/2] w-full rounded-[18px] object-cover" style={`object-position:${p.position}`} />
          <figcaption class="mt-3 text-[13.5px] text-mute">{p.caption}</figcaption>
        </figure>
      ))}
    </div>

    <ul class="m-0 mt-14 grid list-none grid-cols-[repeat(3,minmax(0,1fr))] gap-x-4 gap-y-12 p-0 max-[900px]:grid-cols-[repeat(2,minmax(0,1fr))] max-[600px]:grid-cols-[repeat(1,minmax(0,1fr))] max-[640px]:mt-10 max-[640px]:gap-y-9">
      {build.points.map((it) => (
        <li class="border-t border-line pt-7">
          <i class="block h-[3px] w-[26px] bg-gold" aria-hidden="true"></i>
          <h3 class="mb-0 mt-5 text-[22px] font-black uppercase leading-[1.05] tracking-[-.03em] text-white">{it.title}</h3>
          <p class="mb-0 mt-3 max-w-[380px] text-[16px] leading-[1.6] text-bone/75">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
