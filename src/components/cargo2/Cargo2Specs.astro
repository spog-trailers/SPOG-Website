---
import WorkTitle from '../work/WorkTitle.astro';
import Ws2Text from '../ws2/Ws2Text.astro';
import { srcset } from '../../data/content';
import { specs as cargoSpecs } from '../../data/cargo2Page';
// Another page can pass its own specs (/workstation-2). Cargo 2 uses the default.
// tone "light" (/workstation-2) puts the table on white with a cut-out, so a run of dark sections can break.
interface Props { specs?: { heading: string[]; image: string; alt: string; rows: [string, string][]; fine: string }; tone?: 'dark' | 'light' | 'stone' }
const { specs = cargoSpecs, tone = 'dark' } = Astro.props;
const light = tone !== 'dark';
/**
 * Specs, after Tesla's "Model Y Specs": the side profile and one clean table. Cargo 2's rows follow
 * SPOG's price sheet of 2026-11-20, the Warranty Policy and Nate (see cargo2Page.ts), with the base
 * prices and the fine print that they exclude tax, title, registration and delivery. No payload, lead
 * time or 10 ft height (under research). Another page's rows come from that page's data file.
 * Keeps the id "specs" for the section bar.
 */
---
<section id="specs" aria-label="Specs" class:list={['pb-[120px] pt-[130px] max-[640px]:pb-16 max-[640px]:pt-20', tone === 'stone' ? 'bg-stone text-ink' : light ? 'bg-white text-ink' : 'border-t border-line bg-black text-bone']}>
  <div class="wrap">
    <WorkTitle lines={specs.heading} tone={light ? 'light' : 'dark'} />
    <div class="mt-14 grid grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] items-start gap-x-16 gap-y-10 max-[1000px]:grid-cols-[minmax(0,1fr)]">
      <img src={specs.image} srcset={srcset(specs.image)} sizes="(max-width: 1000px) 100vw, 680px" alt={specs.alt} loading="lazy" class:list={['aspect-[16/9] w-full rounded-[18px]', light ? 'ws2-plate object-contain px-[5%]' : 'object-cover']} />
      <div>
        <dl class="m-0">
          {specs.rows.map(([label, value]) => (
            <div class:list={['grid grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] gap-6 border-b py-[18px] first:pt-0 max-[480px]:grid-cols-[minmax(0,1fr)] max-[480px]:gap-1', light ? 'border-stone-2' : 'border-line']}>
              <dt class:list={['t-fine', light ? 'text-ink-soft' : 'text-mute']}>{label}</dt>
              <dd class:list={['m-0 t-body-sm font-semibold', light ? 'text-coal' : 'text-white']}><Ws2Text text={value} /></dd>
            </div>
          ))}
        </dl>
        <p class:list={['mb-0 mt-6 t-fine', light ? 'text-ink-soft' : 'text-mute']}>{specs.fine}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Studio gray behind a cut-out, like the homepage lineup. */
  .ws2-plate { background: radial-gradient(ellipse 72% 62% at 50% 44%, #f1f0ee 0%, #dcdad7 56%, #c9c7c4 100%); }
</style>
