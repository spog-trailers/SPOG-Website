---
import WorkTitle from '../work/WorkTitle.astro';
import Icon from '../ui/Icon.astro';
import { replaces } from '../../data/cargo2Page';
/**
 * What it saves you (v2), the dark chapter for the numbers, after Tesla's "More Affordable Than
 * a Gas Car": the heading and the burn rate, the fuel number, then three tiles with a line icon
 * each, as in Tesla's "Seat Five / Load Up / Settle In" row. This is the one place the page argues
 * the money, so the hero's "every crew needs a trailer" pitch isn't repeated here.
 * Careful wording on purpose: fewer generator hours, never "no generator" (messaging guardrails).
 */
---
<section id="savings" aria-label="What it saves you" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <WorkTitle lines={replaces.heading} tone="dark" />
    <div class="mt-10 grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-center gap-x-16 gap-y-8 max-[960px]:grid-cols-[minmax(0,1fr)]">
      <p class="m-0 max-w-[560px] t-body text-bone/80">{replaces.body}</p>
      <div class="rounded-[18px] border border-panel-line bg-panel px-9 py-9 max-[640px]:px-6 max-[640px]:py-7">
        <span class="block t-h2 normal-case text-white">{replaces.fuel.value}</span>
        <span class="mt-3 block max-w-[400px] t-body-sm text-mute">{replaces.fuel.label}</span>
      </div>
    </div>
    <ul class="m-0 mt-14 grid list-none grid-cols-[repeat(3,minmax(0,1fr))] gap-3 p-0 max-[900px]:grid-cols-[repeat(1,minmax(0,1fr))] max-[640px]:mt-10">
      {replaces.items.map((it) => (
        <li class="rounded-[18px] border border-panel-line bg-panel px-8 pb-9 pt-8 max-[640px]:px-6 max-[640px]:pb-7 max-[640px]:pt-6">
          <Icon name={it.icon} class="size-[46px] stroke-white stroke-[1.6]" />
          <h3 class="mb-0 mt-7 t-h3 text-white">{it.title}</h3>
          <p class="mb-0 mt-3 max-w-[380px] t-body-sm text-bone/75">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
