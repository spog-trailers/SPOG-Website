---
import WorkTitle from '../work/WorkTitle.astro';
import Icon from '../ui/Icon.astro';
import { replaces } from '../../data/cargo2Page';
/**
 * What it saves you, the dark chapter for the money, after Tesla's "More Affordable Than a Gas Car".
 * Relaid out 2026-11-20 because Nate found the old one awkward (a loose line, a floating number card
 * and two tiles): the heading and the burn rate share one row, then a single panel splits into three
 * columns, the fuel number large in the first and one point in each of the others.
 * This is the one place the page argues the money. The power system has its own section (#power).
 * Careful wording on purpose: fewer generator hours, never "no generator" (messaging guardrails).
 */
const cols = replaces.items.length === 2 ? 'grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_minmax(0,1fr)]' : 'grid-cols-[minmax(0,1.25fr)_repeat(3,minmax(0,1fr))]';
---
<section id="savings" aria-label="What it saves you" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-end gap-x-16 gap-y-6 max-[900px]:grid-cols-[minmax(0,1fr)]">
      <WorkTitle lines={replaces.heading} tone="dark" />
      <p class="m-0 max-w-[520px] t-body text-bone/80">{replaces.body}</p>
    </div>

    <div class:list={['mt-14 grid overflow-hidden rounded-[22px] border border-panel-line bg-panel max-[900px]:grid-cols-[minmax(0,1fr)] max-[640px]:mt-10', cols]}>
      <div class="px-10 py-11 max-[640px]:px-6 max-[640px]:py-8">
        <span class="block t-h1 normal-case text-white">{replaces.fuel.value}</span>
        <span class="mt-4 block max-w-[360px] t-body-sm text-mute">{replaces.fuel.label}</span>
      </div>
      {replaces.items.map((it) => (
        <div class="border-l border-panel-line px-10 py-11 max-[900px]:border-l-0 max-[900px]:border-t max-[640px]:px-6 max-[640px]:py-8">
          <Icon name={it.icon} class="size-[40px] stroke-white stroke-[1.6]" />
          <h3 class="mb-0 mt-6 t-h3 text-white">{it.title}</h3>
          <p class="mb-0 mt-3 max-w-[340px] t-body-sm text-bone/75">{it.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
