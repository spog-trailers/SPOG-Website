---
import WorkTitle from '../work/WorkTitle.astro';
import { replaces } from '../../data/cargo2Page';
/**
 * What it replaces, the dark chapter (the work look keeps one dark chapter for the numbers).
 * The messaging report's case: every crew already tows a trailer, so the power rides along in
 * it. Three outcomes, then the generator fuel math with its source in the data file.
 * Careful wording on purpose: fewer generator hours, never "no generator" (messaging guardrails).
 */
---
<section id="replaces" aria-label="What it replaces" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <div class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-end gap-x-16 gap-y-10 max-[960px]:grid-cols-[minmax(0,1fr)]">
      <div>
        <WorkTitle kicker={replaces.kicker} lines={replaces.heading} tone="dark" />
        <p class="mb-0 mt-7 max-w-[560px] text-[18px] leading-[1.6] text-bone/80">{replaces.body}</p>
      </div>
      <div class="rounded-[18px] border border-panel-line bg-panel px-9 py-9 max-[640px]:px-6 max-[640px]:py-7">
        <span class="block text-[clamp(40px,4.6vw,64px)] font-black leading-[1] tracking-[-.045em] text-white">{replaces.fuel.value}</span>
        <span class="mt-3 block max-w-[400px] text-[15.5px] leading-[1.55] text-mute">{replaces.fuel.label}</span>
      </div>
    </div>
    <ul class="m-0 mt-16 grid list-none grid-cols-[repeat(3,minmax(0,1fr))] gap-4 p-0 max-[900px]:grid-cols-[repeat(1,minmax(0,1fr))] max-[640px]:mt-12">
      {replaces.items.map((it) => (
        <li class="border-t border-line pt-7">
          <i class="block h-[3px] w-[26px] bg-gold" aria-hidden="true"></i>
          <h3 class="mb-0 mt-5 text-[22px] font-black uppercase leading-[1.05] tracking-[-.03em] text-white">{it.title}</h3>
          <p class="mb-0 mt-3 max-w-[380px] text-[16px] leading-[1.6] text-bone/75">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
