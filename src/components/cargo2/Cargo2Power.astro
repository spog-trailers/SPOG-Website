---
import Ws2Media from '../ws2/Ws2Media.astro';
import WorkTitle from '../work/WorkTitle.astro';
import { power } from '../../data/cargo2Page';
/**
 * The power system, its own section near the top of /cargo-2 (Nate, 2026-11-20). Second layout, the
 * same day: Nate didn't love the photo-beside-text version, so this reads like a spec band. A centered
 * heading and line, one wide photo of the battery units with the three numbers over its bottom edge,
 * then the two selling points (bigger tools, overnight charging) side by side underneath.
 * Dark, between the light overview and the light tour. This is the one place the page sells the
 * power system, so the overview has no power card. Keeps the id "power" for the section bar.
 * On phones the numbers drop under the photo instead of sitting on it.
 */
---
<section id="power" aria-label="The power system" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-16 max-[640px]:pt-20">
  <div class="wrap">
    <div class="mx-auto max-w-[760px] text-center [&_h2]:mx-auto">
      <WorkTitle lines={power.heading} tone="dark" />
      <p class="mx-auto mb-0 mt-6 max-w-[620px] t-body text-bone/80">{power.intro}</p>
    </div>

    <div class="relative mt-14 overflow-hidden rounded-[22px] bg-panel max-[640px]:mt-10">
      <Ws2Media media={power.media} sizes="(max-width: 1392px) 100vw, 1248px" class="block aspect-[2.2/1] w-full object-cover max-[900px]:aspect-[16/10] max-[640px]:aspect-[4/3]" />
      <dl class="absolute inset-x-0 bottom-0 m-0 grid grid-cols-[repeat(3,minmax(0,1fr))] bg-[linear-gradient(to_top,rgb(0_0_0/.88)_0%,rgb(0_0_0/.6)_55%,rgb(0_0_0/0)_100%)] px-10 pb-9 pt-24 max-[640px]:static max-[640px]:grid-cols-[minmax(0,1fr)] max-[640px]:bg-none max-[640px]:px-6 max-[640px]:pb-2 max-[640px]:pt-4">
        {power.stats.map(([v, k]) => (
          <div class="flex flex-col-reverse gap-1.5 not-first:border-l not-first:border-white/20 not-first:pl-8 max-[640px]:flex-row-reverse max-[640px]:items-baseline max-[640px]:justify-between max-[640px]:py-4 max-[640px]:not-first:border-l-0 max-[640px]:not-first:border-t max-[640px]:not-first:border-panel-line max-[640px]:not-first:pl-0">
            <dt class="t-label text-bone/75">{k}</dt>
            <dd class="m-0 whitespace-nowrap t-h2 normal-case text-white max-[640px]:t-h3">{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <ul class="m-0 mt-12 grid list-none grid-cols-[repeat(2,minmax(0,1fr))] gap-x-16 gap-y-10 p-0 max-[900px]:grid-cols-[minmax(0,1fr)] max-[640px]:mt-10">
      {power.points.map((p) => (
        <li class="border-t border-panel-line pt-7">
          <h3 class="m-0 t-h3 text-white">{p.title}</h3>
          <p class="mb-0 mt-3 max-w-[520px] t-body-sm text-bone/75">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
