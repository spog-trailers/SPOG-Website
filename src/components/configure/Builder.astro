---
/**
 * The builder, shared by /configure/cargo and /configure/workstation (2026-11-20), laid out like
 * Tesla's design studio (Nate, 2026-11-18):
 * a big white viewer on the left that you can drag all the way around, and one scrolling column
 * of choices on the right. The viewer turns to whatever section you're in, and a bar along the
 * bottom keeps the price and the order button in reach.
 *
 * The trailer is a 3D model built in code from Nate's photos of the finished black 20 ft Cargo.
 * The OPTIONS are real: they follow SPOG's "Trailer Customization Options" sheet (SPOG-D-0001)
 * and the color list Nate sent, in the sheet's order and mostly its words. The PRICES are real
 * since 2026-11-20 (SOURCE price sheet 2026-11-20, approved by Nate): Cargo 10 $15,000, Cargo 20
 * $50,000, battery steps, climate control, Starlink, the 6 ft light and the 28 ft tower. Options
 * the sheet doesn't price show as Quoted and stay out of the total. There is no deposit or delivery
 * fee (the old sample numbers were removed). See src/scripts/configurator/data.ts. Nothing is sent
 * anywhere and no payment is taken. Not indexed.
 */
import Base from '../../layouts/Base.astro';
import { img, phone } from '../../data/content';
import { BATTERIES, BENCH_LENGTHS, CONNECT, FINISHES, INTERIOR, LOGO_SPOTS, PAINTS, SHORE, SIZES, TOOLS, TOWER_CAMERAS, moneyTotal, useKind, type Option } from '../../scripts/configurator/data';

// Which trailer. The Workstation builder opened once its 3D model existed (Nate, 2026-11-20).
interface Props { kind?: 'cargo' | 'workstation' }
const { kind = 'cargo' } = Astro.props;
const ws = kind === 'workstation';
useKind(kind);
const sizes = SIZES;
const interior = INTERIOR;
const tname = ws ? 'Workstation' : 'Cargo';

const card = 'mt-3 rounded-[10px] bg-[#f4f4f4] px-6 pb-6 pt-5 max-[480px]:px-5';
const h2 = 'm-0 text-[22px] font-semibold tracking-[-.02em] text-ink';
const row = 'flex items-baseline justify-between gap-4 text-[14px] text-ink';
const name = 'font-semibold';
const sub = 'mt-0.5 text-[13.5px] leading-[1.45] text-ink-soft';
const choice = 'flex w-full cursor-pointer items-start gap-3 rounded-[6px] border border-[#cfd0d2] bg-transparent px-4 py-[13px] text-left text-ink transition-[border-color,box-shadow,background-color] hover:border-[#8f9195] aria-pressed:border-ink aria-pressed:bg-white aria-pressed:shadow-[inset_0_0_0_1px_#23262B] disabled:cursor-not-allowed disabled:opacity-40';
const tick = 'mt-[2px] grid size-[18px] shrink-0 place-items-center rounded-[3px] border border-[#b9babd] bg-white text-transparent group-aria-pressed:border-ink group-aria-pressed:bg-ink group-aria-pressed:text-white';
const seg = 'h-[44px] cursor-pointer rounded-[6px] border border-[#cfd0d2] bg-transparent text-[13.5px] font-semibold text-ink transition-[border-color,box-shadow,background-color] hover:border-[#8f9195] aria-pressed:border-ink aria-pressed:bg-white aria-pressed:shadow-[inset_0_0_0_1px_#23262B] disabled:cursor-not-allowed disabled:opacity-35';
const field = 'w-full rounded-[6px] border border-[#cfd0d2] bg-white px-4 py-[12px] text-[16px] text-ink placeholder:text-[#9a9894] focus-visible:border-ink';
const label = 'mb-1.5 block text-[12.5px] font-semibold text-ink-soft';
const primary = 'inline-flex h-[44px] cursor-pointer items-center justify-center rounded-[6px] border-0 bg-gold px-7 text-[14px] font-semibold text-black transition-colors hover:bg-[#f5b233]';
const round = 'grid size-[34px] cursor-pointer place-items-center rounded-[6px] border-0 bg-[#f1f1f1] text-ink transition-colors hover:bg-[#e4e4e4]';

const check = '<svg viewBox="0 0 24 24" class="size-3 fill-none stroke-current stroke-[3.4]" aria-hidden="true"><path d="M4 12.5l5 5L20 6"/></svg>';
const chip = 'cursor-pointer rounded-full border border-[#cfd0d2] bg-transparent px-3 py-1.5 text-[12.5px] font-semibold text-ink hover:border-[#8f9195] aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white';
const mini = 'grid size-[34px] cursor-pointer place-items-center rounded-[6px] border border-[#cfd0d2] bg-white text-[16px] font-semibold text-ink hover:border-[#8f9195] disabled:cursor-not-allowed disabled:opacity-35';
const groups = (list: Option[]) => [...new Set(list.map((o) => o.group))].map((g) => ({ name: g, items: list.filter((o) => o.group === g) }));
// Options that take a quantity, a size or a choice once they're checked.
// 2026-11-20 (price sheet): cabinets are gone, the extra desk replaces the old desk add-on, the tower picks its camera.
const details: Record<string, { kind: 'count' | 'length' | 'camera'; key: string; label: string }> = {
  extraDesk: { kind: 'count', key: 'desks', label: 'Quantity' },
  bench: { kind: 'length', key: 'benchLength', label: 'Length' },
  tower: { kind: 'camera', key: 'towerCamera', label: 'Camera' }, // NATE 2026-11-20: AI camera or regular security camera, same price
};

const callouts = [
  { id: 'solar', label: 'Solar roof', text: 'Panels across the roof charge the battery while you work.', dir: 'up', len: 84 },
  { id: 'power', label: 'Power system', text: 'The battery and inverter are built in and run the outlets inside and out.', dir: 'up', len: 52 }, // NEW 2026-11-20 (facts only)
  { id: 'door', label: ws ? 'Entry door' : 'Side entry door', text: ws ? 'Walk in from the curb side.' : 'Walk in from the curb side without opening the rear.', dir: 'down', len: 96 },
  { id: 'wheels', label: 'Wheels and fenders', text: ws ? 'Black wheels in gloss charcoal fenders, two axles.' : 'Black machined wheels under brushed aluminum fenders.', dir: 'down', len: 64 },
];
const views = [['front', 'Front'], ['side', 'Side'], ['rear', 'Rear'], ['street', 'Street side'], ['top', 'Roof'], ['interior', 'Interior']];
---
<Base title={`Design your ${tname} | SPOG Trailers`} description={`Design a SPOG ${tname} trailer in 3D and see the price as you build it.`} noindex>
  <div id="cfg" data-kind={kind} data-step="design" class="group/cfg min-h-screen bg-white text-ink">
    <!-- Top bar -->
    <header class="fixed inset-x-0 top-0 z-40 flex h-[56px] items-center justify-between bg-white px-7 max-[640px]:px-4">
      <div class="flex items-center gap-6 max-[640px]:gap-4">
        <a href="/" aria-label="SPOG Trailers home"><img src={img.logoDark} alt="SPOG" class="h-[26px] w-auto" /></a>
        <a href="/configure" class="text-[12.5px] font-semibold text-ink-soft no-underline hover:text-ink">&larr; All trailers</a>
      </div>
      <div class="flex items-center gap-5 text-[12.5px] text-ink-soft">
        <span class="rounded-full bg-[#f4f4f4] px-3 py-1 font-semibold max-[899px]:hidden">Prices exclude tax, title, registration and delivery.</span><!-- SOURCE price sheet 2026-11-20, replaces the sample-pricing badge -->
        <a href={phone.href} class="font-semibold text-ink no-underline hover:underline">{phone.display}</a>
      </div>
    </header>

    <div class="pt-[56px] min-[900px]:grid min-[900px]:grid-cols-[minmax(0,1fr)_440px] min-[1500px]:grid-cols-[minmax(0,1fr)_470px]">
      <!-- Viewer -->
      <section id="viewer" aria-label={`3D view of your ${tname}`} class="sticky top-[56px] z-20 h-[44vh] min-h-[300px] select-none overflow-hidden bg-white max-[899px]:border-b max-[899px]:border-[#ececec] min-[900px]:h-[calc(100vh_-_56px_-_76px)]">
        <div id="stage" class="absolute inset-0 cursor-grab active:cursor-grabbing"></div>

        <div id="callouts" class="pointer-events-none absolute inset-0 max-[899px]:hidden" aria-hidden="true">
          {callouts.map((c) => (
            <div class="co" data-anchor={c.id} data-dir={c.dir} style={`--len:${c.len}px`}>
              <i class="co-line"></i>
              <div class="co-tag">
                <button type="button" tabindex="-1" class="co-btn">{c.label}<b>+</b></button>
                <p class="co-text">{c.text}</p>
              </div>
            </div>
          ))}
        </div>

        <p id="hint" class="pointer-events-none absolute left-1/2 top-4 m-0 -translate-x-1/2 rounded-full bg-[#f4f4f4] px-3.5 py-1.5 text-[12px] font-semibold text-ink-soft transition-opacity duration-500 max-[899px]:top-2">Drag to turn it around</p>
        <p id="note" role="status" class="pointer-events-none absolute bottom-[72px] left-1/2 m-0 w-max max-w-[86%] -translate-x-1/2 rounded-[6px] bg-ink px-4 py-2 text-center text-[13px] text-white opacity-0 transition-opacity duration-300"></p>

        <button id="doors" type="button" aria-pressed="false" class="absolute bottom-5 left-6 h-[34px] cursor-pointer rounded-[6px] border-0 bg-[#f1f1f1] px-3.5 text-[12.5px] font-semibold text-ink transition-colors hover:bg-[#e4e4e4] max-[899px]:bottom-3 max-[899px]:left-3">Open doors</button>

        <div class="absolute bottom-5 left-1/2 flex -translate-x-1/2 items-center gap-2 max-[899px]:bottom-3 max-[640px]:left-auto max-[640px]:right-3 max-[640px]:translate-x-0">
          <button type="button" data-view-step="-1" aria-label="Previous view" class={round}><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d="M15 5l-7 7 7 7" /></svg></button>
          <div class="flex h-[34px] items-center gap-0.5 rounded-[6px] bg-[#f1f1f1] px-2">
            {views.map(([id, title]) => (
              <button type="button" data-view={id} aria-label={`${title} view`} aria-pressed="false" class="group grid size-[18px] cursor-pointer place-items-center border-0 bg-transparent p-0">
                <i class="block size-[7px] rounded-full bg-[#c4c5c7] transition-colors group-hover:bg-[#8f9195] group-aria-pressed:bg-ink"></i>
              </button>
            ))}
          </div>
          <button type="button" data-view-step="1" aria-label="Next view" class={round}><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d="M9 5l7 7-7 7" /></svg></button>
        </div>
        <p class="pointer-events-none absolute bottom-6 right-6 m-0 max-w-[220px] text-right text-[11.5px] leading-[1.4] text-ink-soft max-[899px]:bottom-[52px] max-[899px]:left-3 max-[899px]:right-auto max-[899px]:max-w-none max-[899px]:text-left">Computer-generated model. The finished trailer may differ.</p>
        <noscript><p class="absolute inset-0 m-0 grid place-items-center text-ink-soft">The 3D view needs JavaScript.</p></noscript>
      </section>

      <!-- Choices -->
      <aside id="panel" class="relative z-10 bg-white px-7 pb-[140px] pt-9 max-[899px]:pt-6 max-[640px]:px-4">
        <!-- ============ Design ============ -->
        <div data-panel="design">
          <h1 class="m-0 text-center text-[40px] font-semibold leading-[1.1] tracking-[-.03em] text-ink">{tname}</h1>
          {/* The estimated build time was removed on 2026-11-20: no source gives a lead time. */}

          <section data-section data-view="front" class={`${card} mt-7`}>
            <dl class="m-0 grid grid-cols-[repeat(3,1fr)] gap-3">
              {[['length', 'Length'], ['battery', 'Battery'], ['solar', 'Roof solar']].map(([id, title]) => (
                <div><dd data-out={`stat-${id}`} class="m-0 text-[22px] font-semibold tracking-[-.02em] text-ink"></dd><dt class="text-[12.5px] text-ink-soft">{title}</dt></div>
              ))}
            </dl>
            <div class="mt-5 grid gap-2">
              {sizes.map((s) => (
                <button type="button" data-opt="length" data-value={s.ft} data-go="front" aria-pressed="false" class={`${choice} items-center justify-between`}>
                  <span><span class="block text-[14.5px] font-semibold">{s.name}</span><span class="block text-[13px] text-ink-soft">{s.note}</span></span>
                  <span class="text-[14.5px] font-semibold">{moneyTotal(s.price)}</span>
                </button>
              ))}
            </div>
            {/* SOURCE price sheet 2026-11-20 Included list. Solar and battery are in the stats and Power, the desk is in Interior. Vinyl floor per NATE 2026-11-20. */}
            {ws ? (
              <p class="mb-0 mt-3 text-[12.5px] text-ink-soft">Every Workstation includes climate control and is insulated in the walls, floor and ceiling, with a vinyl floor and a built-in work desk. The 20 ft adds a hyper-heating heat pump and a choice of white composite or premium wood inside.</p>
            ) : (
              <p class="mb-0 mt-3 text-[12.5px] text-ink-soft">Every Cargo is insulated in the walls, floor and ceiling, with white composite walls over plywood, a vinyl floor, a side entry door and rear double doors.</p>
            )}
          </section>

          <section data-section data-view="front" class={card}>
            <h2 class={h2}>Exterior</h2>
            <div class={`${row} mt-4`}><span data-out="name-paint" class={name}></span><span>Included</span></div>
            <div class="mt-2 flex flex-wrap gap-x-0.5 gap-y-0">
              {PAINTS.map((p) => <button type="button" data-opt="paint" data-value={p.id} data-go="front" aria-label={p.name} title={p.name} aria-pressed="false" class:list={['sw', p.matte && 'sw-matte']} style={`--c:${p.hex}`}></button>)}
            </div>
            <p class="mb-0 mt-1.5 text-[12.5px] text-ink-soft">Your SPOG contact will confirm the color.</p>

            <div class={`${row} mt-6`}><span class={name}>Company logo</span><span data-out="price-logo"></span></div>
            <p class={`${sub} m-0`}>Pick where you want it.</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {LOGO_SPOTS.map((l) => <button type="button" data-toggle="logoSpots" data-value={l.id} data-go={l.view} aria-pressed="false" class={chip}>{l.name}</button>)}
              <button type="button" id="logo-all" aria-pressed="false" class={chip}>All</button>
            </div>
            <div id="logo-fields" class="mt-2.5 hidden">
              <input id="brand-text" type="text" maxlength="26" placeholder="Your company name" aria-label="Company name for the logo" class={field} />
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px]">
                <label class="cursor-pointer font-semibold text-ink underline underline-offset-4">Or upload your logo<input id="logo-file" type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" class="sr-only" /></label>
                <button type="button" id="logo-clear" class="hidden cursor-pointer border-0 bg-transparent p-0 font-semibold text-ink-soft underline underline-offset-4">Remove the file</button>
                <span class="text-ink-soft">The file stays on this device.</span>
              </div>
            </div>

            <button type="button" data-flag="lettering" aria-pressed="false" class={`${choice} group mt-6`}>
              <span class={tick} set:html={check}></span>
              <span class="flex-1"><span class="flex justify-between gap-3 text-[14px] font-semibold"><span>Vinyl lettering or numbers</span><span class="font-normal">Quoted</span></span></span>
            </button>
            <input id="lettering-text" type="text" maxlength="80" placeholder="Describe what you need" aria-label="Describe the lettering or numbers" class={`${field} mt-2 hidden`} />
          </section>

          <section data-section data-view="interior" class={card}>
            <h2 class={h2}>Power</h2>
            <div class={`${row} mt-4`}><span data-out="name-battery" class={name}></span><span data-out="price-battery"></span></div>
            <p data-out="battery-sub" class={`${sub} m-0`}></p>
            {/* SOURCE price sheet 2026-11-20: 5 kWh steps up to 20 kWh. Steps below the length's base are greyed out by ui.ts. */}
            <div class="mt-2.5 grid grid-cols-[repeat(4,1fr)] gap-1.5">
              {BATTERIES.map((b) => <button type="button" data-opt="battery" data-value={b.id} data-go="interior" aria-pressed="false" class={`${seg} max-[420px]:text-[12px]`}>{b.kwh} kWh</button>)}
            </div>

            {/* SOURCE price sheet 2026-11-20: voltage is set by the length (no 240 V), so it's shown as included, not picked. */}
            <div class={`${row} mt-6`}><span class={name}>Inverter and outlets</span><span>Included</span></div>
            <p data-out="power-included" class={`${sub} m-0`}></p>

            {/* NATE 2026-11-20: shore power stays available but isn't on the price sheet, so it's quoted. */}
            <div class={`${row} mt-6`}><span class={name}>Shore power connection</span><span data-out="price-shore"></span></div>
            <p class={`${sub} m-0`}>Pick the plug-in size for site or grid power. Your SPOG contact prices it with your build.</p> {/* NEW 2026-11-20, full sentences */}
            <div class="mt-2.5 grid grid-cols-[repeat(3,1fr)] gap-1.5">
              {SHORE.map((v) => <button type="button" data-opt="shore" data-value={v.id} aria-pressed="false" class={seg}>{v.name}</button>)}
            </div>

            <div class="mt-6 rounded-[8px] bg-white px-4 pb-4 pt-3.5">
              <p class="m-0 text-[14px] font-semibold">What runs on a normal day?</p>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {TOOLS.map((t) => <button type="button" data-toggle="tools" data-value={t.id} aria-pressed="false" class={chip}>{t.name}</button>)}
              </div>
              <div class="mt-4 h-[6px] overflow-hidden rounded-full bg-[#e6e6e6]"><i data-out="run-bar" class="block h-full rounded-full bg-gold transition-[width] duration-500"></i></div>
              <p data-out="run-head" class="mb-0 mt-2.5 text-[14px] font-semibold"></p>
              <p data-out="run-detail" class={`${sub} m-0`}></p>
              <p class="mb-0 mt-2 text-[11.5px] text-ink-soft">A rough estimate with a full battery, four hours of sun and nothing plugged in. Tool draws are typical figures.</p>
            </div>
          </section>

          {[
            { title: 'Interior', intro: 'What you would like built in or installed inside.', view: 'interior', list: interior },
            { title: 'Connectivity and security', intro: 'How the trailer gets online, and how it lights up the site after dark.', view: 'street', list: CONNECT }, // NEW 2026-11-20, the 6 ft light is a light only
          ].map((sec) => (
            <section data-section data-view={sec.view} class={card}>
              <h2 class={h2}>{sec.title}</h2>
              <p class={`${sub} mb-0`}>{sec.intro}</p>
              {/* SOURCE price sheet 2026-11-20: one built-in front corner work desk is standard on every Cargo. */}
              {sec.list === interior && ws && (
                <Fragment>
                  <div class={`${row} mt-5 rounded-[6px] bg-white px-4 py-[13px]`}><span><span class="block font-semibold">Climate control</span><span class={`${sub} block`}>Heating and cooling on every Workstation, with a hyper-heating heat pump on the 20 ft.</span></span><span class="shrink-0">Included</span></div>
                  <div class={`${row} mt-2 rounded-[6px] bg-white px-4 py-[13px]`}><span><span class="block font-semibold">Built-in work desk</span><span class={`${sub} block`}>Standard on every Workstation.</span></span><span class="shrink-0">Included</span></div>
                  <h3 class="mb-0 mt-5 text-[13px] font-semibold text-ink-soft">Interior finish</h3>
                  <div class="mt-2 grid grid-cols-[repeat(2,1fr)] gap-2">
                    {FINISHES.map((f) => <button type="button" data-opt="interior" data-value={f.id} data-go="interior" aria-pressed="false" class={`${seg} disabled:cursor-not-allowed disabled:opacity-35`}>{f.name}</button>)}
                  </div>
                  <p class={`${sub} mb-0 mt-2`}>A free choice on the 20 ft. The 10 ft comes in white composite.</p>
                </Fragment>
              )}
              {sec.list === interior && !ws && (
                <div class={`${row} mt-5 rounded-[6px] bg-white px-4 py-[13px]`}><span><span class="block font-semibold">Built-in corner work desk</span><span class={`${sub} block`}>In the front corner of every Cargo.</span></span><span class="shrink-0">Included</span></div>
              )}
              {groups(sec.list).map((grp) => (
                <Fragment>
                  <h3 class="mb-0 mt-5 text-[13px] font-semibold text-ink-soft">{grp.name}</h3>
                  <div class="mt-2 grid gap-2">
                    {grp.items.map((a) => (
                      <Fragment>
                        <button type="button" data-toggle="options" data-value={a.id} data-go={a.view} aria-pressed="false" class={`${choice} group`}>
                          <span class={tick} set:html={check}></span>
                          <span class="flex-1"><span class="flex justify-between gap-3 text-[14px] font-semibold"><span>{a.name}</span><span data-out={`price-opt-${a.id}`} class="font-normal"></span></span>{a.desc && <span class={`${sub} block`}>{a.desc}</span>}</span>
                        </button>
                        {details[a.id] && (
                          <div data-detail={a.id} class="-mt-1 hidden items-center justify-between gap-3 rounded-[6px] bg-white px-4 py-2.5 text-[13.5px]">
                            <span class="font-semibold">{details[a.id].label}</span>
                            {details[a.id].kind === 'count' ? (
                              <span class="flex items-center gap-2">
                                <button type="button" data-step={details[a.id].key} data-delta="-1" aria-label="One fewer" class={mini}>&minus;</button>
                                <span data-out={`count-${details[a.id].key}`} class="w-5 text-center font-semibold"></span>
                                <button type="button" data-step={details[a.id].key} data-delta="1" aria-label="One more" class={mini}>+</button>
                              </span>
                            ) : details[a.id].kind === 'length' ? (
                              <span class="flex gap-1.5">
                                {BENCH_LENGTHS.map((ft) => <button type="button" data-opt="benchLength" data-value={ft} data-go="interior" aria-pressed="false" class={`${seg} h-[34px] px-3`}>{ft} ft</button>)}
                              </span>
                            ) : (
                              <span class="flex gap-1.5">
                                {TOWER_CAMERAS.map((c) => <button type="button" data-opt="towerCamera" data-value={c.id} data-go="street" aria-pressed="false" class={`${seg} h-[34px] px-3`}>{c.name}</button>)}
                              </span>
                            )}
                          </div>
                        )}
                      </Fragment>
                    ))}
                  </div>
                </Fragment>
              ))}
            </section>
          ))}

          <!-- Summary -->
          <section id="summary" data-section data-view="front" class="mt-10 px-1">
            <details class="group text-center">
              <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[13.5px] font-semibold text-ink [&::-webkit-details-marker]:hidden">Show pricing details<svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current stroke-[2.4] transition-transform group-open:rotate-180"><path d="M5 9l7 7 7-7" /></svg></summary>
              <ul data-out="lines" class="m-0 mt-4 grid list-none gap-2 p-0 text-left text-[13.5px]"></ul>
            </details>
            {/* SOURCE price sheet 2026-11-20. The sample deposit and "Due today" were removed. */}
            <div class="mt-6 flex items-baseline justify-between text-[20px] font-semibold tracking-[-.02em]"><span>Purchase price</span><span data-out="vehicle"></span></div>
            <p class="m-0 mt-1 text-[12.5px] text-ink-soft">Prices exclude tax, title, registration and delivery. <span data-out="quoted"></span></p>
            <p class="m-0 mt-2 text-[12.5px] text-ink-soft">Availability and final specifications are confirmed in writing by SPOG.</p>
            <button type="button" data-goto="order" class={`${primary} mt-6 w-full`}>Order now</button>
            <button type="button" id="share" class="mt-3 w-full cursor-pointer border-0 bg-transparent text-[13.5px] font-semibold text-ink underline underline-offset-4">Copy a link to this build</button>
          </section>
        </div>

        <!-- ============ Order ============ -->
        <div data-panel="order" hidden>
          <button type="button" data-goto="design" class="cursor-pointer border-0 bg-transparent p-0 text-[13.5px] font-semibold text-ink underline underline-offset-4">&larr; Edit design</button>
          <h1 class="mb-0 mt-5 text-[32px] font-semibold leading-[1.1] tracking-[-.03em]">Order your {tname}</h1>
          <p data-out="summary" class="mb-0 mt-2 text-[13.5px] text-ink-soft"></p>

          <section class={`${card} mt-6`}>
            <h2 class={h2}>Delivery</h2>
            <div class="mt-4 grid gap-2">
              <button type="button" data-opt="delivery" data-value="pickup" aria-pressed="false" class={choice}>
                <span class="flex-1"><span class="flex justify-between gap-3 text-[14px] font-semibold"><span>Pick up in Middletown, NY</span><span class="font-normal">Included</span></span><span class={`${sub} block`}>We walk you through the trailer at the shop.</span></span>
              </button>
              <button type="button" data-opt="delivery" data-value="delivery" aria-pressed="false" class={choice}>
                <span class="flex-1"><span class="flex justify-between gap-3 text-[14px] font-semibold"><span>Delivered to your site</span><span class="font-normal">Quoted</span></span><span class={`${sub} block`}>Your SPOG contact prices delivery to your site.</span></span>
              </button>
            </div>
            <div id="zip-wrap" class="mt-3 hidden"><label for="zip" class={label}>Delivery ZIP code</label><input id="zip" inputmode="numeric" maxlength="5" autocomplete="postal-code" class={field} /></div>
          </section>

          <section class={card}>
            <h2 class={h2}>Your details</h2>
            <form id="order-form" class="mt-4 grid gap-3" novalidate>
              <div><label for="o-name" class={label}>Name</label><input id="o-name" name="name" autocomplete="name" required class={field} /></div>
              <div><label for="o-company" class={label}>Company</label><input id="o-company" name="company" autocomplete="organization" class={field} /></div>
              <div><label for="o-email" class={label}>Email</label><input id="o-email" name="email" type="email" autocomplete="email" required class={field} /></div>
              <div><label for="o-phone" class={label}>Phone</label><input id="o-phone" name="phone" type="tel" autocomplete="tel" class={field} /></div>
              <p id="order-error" role="alert" class="m-0 hidden text-[13px] font-semibold text-[#b3261e]">Add your name and a valid email to continue.</p>
            </form>
          </section>

          <section class="mt-8 px-1">
            <ul class="m-0 grid list-none gap-2 p-0 text-[14px]">
              {/* 2026-11-20: the sample delivery fee, total and deposit were removed. Delivery is quoted. */}
              <li class="flex justify-between text-[20px] font-semibold tracking-[-.02em]"><span>Purchase price</span><span data-out="vehicle"></span></li>
              <li class="flex justify-between"><span>Delivery</span><span data-out="delivery"></span></li>
            </ul>
            <p class="m-0 mt-2 text-[12.5px] text-ink-soft">Prices exclude tax, title, registration and delivery.</p>
            <button type="submit" form="order-form" class={`${primary} mt-6 w-full`}>Place order</button>
            <p class="m-0 mt-3 text-center text-[12.5px] text-ink-soft">This is a concept. No payment is taken and nothing is sent.</p>
          </section>
        </div>

        <!-- ============ Done ============ -->
        <div data-panel="done" hidden>
          <h1 class="m-0 text-[32px] font-semibold leading-[1.1] tracking-[-.03em]">Your {tname} is designed.</h1>
          <p class="mb-0 mt-3 text-[15px] leading-[1.55] text-ink-soft">On the live site this is where your build goes to the shop. For now, this code and the link in your address bar hold the design.</p>
          <div class={`${card} mt-6`}>
            <p class="m-0 text-[12.5px] text-ink-soft">Build code</p>
            <p data-out="code" class="m-0 mt-1 text-[24px] font-semibold tracking-[-.01em]"></p>
            <p data-out="summary" class="mb-0 mt-3 text-[13.5px] text-ink-soft"></p>
            <ul data-out="lines" class="m-0 mt-4 grid list-none gap-2 p-0 text-[13.5px]"></ul>
          </div>
          <button type="button" data-goto="design" class={`${primary} mt-6 w-full`}>Back to the design</button>
          <button type="button" id="reset" class="mt-3 w-full cursor-pointer border-0 bg-transparent text-[13.5px] font-semibold text-ink underline underline-offset-4">Start a new build</button>
        </div>
      </aside>
    </div>

    <!-- Bottom bar -->
    <div class="fixed inset-x-0 bottom-0 z-40 flex h-[76px] items-center justify-between gap-4 bg-white px-7 shadow-[0_-1px_0_#ececec,0_-12px_28px_rgb(0_0_0/.05)] max-[640px]:h-[68px] max-[640px]:px-4">
      <div class="min-w-0">
        <p class="m-0 truncate text-[18px] font-semibold tracking-[-.02em] max-[640px]:text-[16px]" data-out="title"></p>
        <p class="m-0 truncate text-[12.5px] text-ink-soft max-[640px]:hidden" data-out="summary"></p>
      </div>
      <div class="flex shrink-0 items-center gap-7 max-[640px]:gap-4">
        <div class="text-right"><p class="m-0 text-[22px] font-semibold leading-[1.1] tracking-[-.02em] max-[640px]:text-[18px]" data-out="vehicle"></p><p class="m-0 text-[12px] text-ink-soft">Purchase price</p></div>
        <button type="button" data-goto="order" class={`${primary} group-data-[step=order]/cfg:hidden group-data-[step=done]/cfg:hidden max-[640px]:px-5`}>Order now</button>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Paint and trim chips: a lit sphere, with a ring when picked, like Tesla's. */
  .sw { position: relative; width: 46px; height: 46px; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer; }
  .sw::before {
    content: ''; position: absolute; inset: 6px; border-radius: 50%;
    background: radial-gradient(circle at 34% 26%, color-mix(in srgb, var(--c) 55%, white), var(--c) 55%, color-mix(in srgb, var(--c) 72%, black));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / .14);
  }
  .sw[aria-pressed='true'] { box-shadow: inset 0 0 0 2px #23262b; }
  .sw:hover:not([aria-pressed='true']) { box-shadow: inset 0 0 0 1px #b9babd; }
  .sw-matte::before { background: radial-gradient(circle at 34% 26%, color-mix(in srgb, var(--c) 88%, white), var(--c) 70%); }

  /* Callouts pinned to points on the model. The script sets --x and --y every frame. */
  .co { position: absolute; left: 0; top: 0; transform: translate(var(--x, -999px), var(--y, -999px)); opacity: 0; transition: opacity .35s; }
  .co[data-on] { opacity: 1; }
  .co-line { position: absolute; left: 0; width: 1px; height: var(--len); background: #b9babd; }
  .co[data-dir='up'] .co-line { bottom: 0; }
  .co[data-dir='down'] .co-line { top: 0; }
  .co-tag { position: absolute; left: 8px; width: 230px; }
  .co[data-dir='up'] .co-tag { bottom: calc(var(--len) - 16px); }
  .co[data-dir='down'] .co-tag { top: calc(var(--len) - 16px); }
  .co-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0; border: 0; background: none; font: inherit; font-size: 13px; font-weight: 600; color: #5c5e62; cursor: pointer; }
  .co-btn b { display: grid; place-items: center; width: 17px; height: 17px; border-radius: 4px; background: #f1f1f1; font-weight: 600; color: #23262b; line-height: 1; }
  .co[data-on] .co-btn { pointer-events: auto; }
  .co-text { display: none; margin: 6px 0 0; padding: 10px 12px; border-radius: 6px; background: #fff; box-shadow: 0 6px 24px rgb(0 0 0 / .12); font-size: 13px; line-height: 1.45; color: #23262b; }
  .co[data-open] .co-text { display: block; }
</style>

<script>
  import { initConfigurator } from '../../scripts/configurator/ui';
  initConfigurator();
</script>
