---
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import { jobsite, problem } from '../../data/testHome';
// Closes the Work lane: what the crew stops paying for. Content is the live homepage's Problem
// section, set dark so the page keeps its photo, dark, light rhythm.
---
<section aria-label="Why crews switch" class="bg-black pb-[120px] pt-[120px] text-bone max-[640px]:pb-20 max-[640px]:pt-20">
  <div class="wrap grid grid-cols-[5fr_7fr] items-start gap-[60px] max-[960px]:grid-cols-[repeat(1,1fr)] max-[960px]:gap-10">
    <div>
      <Eyebrow gold={jobsite.eyebrow.gold} text={jobsite.eyebrow.text} />
      <Heading class="mt-4 max-w-[520px] text-white">{problem.heading}</Heading>
      <p class="mt-[18px] max-w-[600px] text-[19px] text-mute">{problem.sub}</p>
      <a href="#walkthrough" class="mt-6 inline-block text-[15px] font-semibold text-bone underline underline-offset-[5px] hover:text-white">See it run your tools on a walkthrough &rarr;</a>
    </div>
    <div class="grid auto-rows-fr grid-cols-[repeat(2,1fr)] gap-3 max-[560px]:grid-cols-[repeat(1,1fr)]">
      <div class="flex min-h-[220px] flex-col justify-between border-[1.5px] border-gold/60 bg-panel px-[30px] pb-8 pt-[30px]">
        <strong class="text-[clamp(40px,4vw,58px)] font-extrabold leading-none tracking-[-.045em] text-gold">{problem.stat.value}</strong>
        <div>
          <b class="mt-[26px] block text-[22px] font-semibold tracking-[-.02em] text-white">{problem.stat.title}</b>
          <span class="mt-1.5 block text-[15.5px] text-mute">{problem.stat.body}</span>
        </div>
      </div>
      {problem.cards.map((c) => (
        <div class="flex min-h-[220px] flex-col justify-between border-[1.5px] border-panel-line bg-panel px-[30px] pb-8 pt-[30px]">
          <Icon name={c.icon} class="size-[34px] stroke-bone stroke-[1.5]" />
          <div>
            <b class="mt-[26px] block text-[22px] font-semibold tracking-[-.02em] text-white">{c.title}</b>
            <span class="mt-1.5 block text-[15.5px] text-mute">{c.body}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
