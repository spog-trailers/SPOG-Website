---
import Eyebrow from '../ui/Eyebrow.astro';
import { pillars } from '../../data/testHome';
// The one place the homepage sells: what every SPOG shares. Five words, one line each, no icons.
---
<section aria-label="What every SPOG is built on" class="bg-black pb-[120px] pt-[130px] text-bone max-[640px]:pb-20 max-[640px]:pt-20">
  <div class="wrap">
    <Eyebrow gold={pillars.eyebrow} />
    <h2 class="m-0 mt-4 max-w-[920px] text-[clamp(36px,4.6vw,62px)] font-semibold leading-[1.03] tracking-[-.035em] text-white">{pillars.heading}</h2>
    <ul class="m-0 mt-16 grid list-none grid-cols-[repeat(5,1fr)] border-t border-line p-0 max-[1100px]:grid-cols-[repeat(3,1fr)] max-[640px]:grid-cols-[repeat(1,1fr)] max-[640px]:mt-12">
      {pillars.items.map((p) => (
        <li class="border-line pr-6 pt-8 max-[1100px]:pb-10 [&:not(:first-child)]:border-l [&:not(:first-child)]:pl-7 max-[1100px]:[&:nth-child(4)]:border-l-0 max-[1100px]:[&:nth-child(4)]:pl-0 max-[640px]:border-l-0! max-[640px]:pl-0! max-[640px]:pb-8 max-[640px]:[&:not(:first-child)]:border-t">
          <b class="block whitespace-nowrap text-[clamp(20px,1.6vw,26px)] font-semibold tracking-[-.025em] text-white">{p.title}</b>
          <span class="mt-3 block max-w-[260px] text-[16px] leading-[1.55] text-mute">{p.body}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
