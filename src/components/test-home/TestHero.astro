---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { img } from '../../data/content';
import { hero } from '../../data/testHome';
// Every prop defaults to the first test homepage's copy. The homepage passes its own.
// `size` is the heading's font-size class. Three-line headings need a smaller one.
interface Props {
  eyebrow?: { gold?: string; text?: string } | null;
  heading?: string[];
  sub?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  size?: string;
}
const {
  eyebrow = hero.eyebrow,
  heading = hero.heading,
  sub = hero.sub,
  primary = { label: hero.primary, href: '#lineup' },
  secondary = { label: 'Book a walkthrough', href: '#walkthrough' },
  size = 'text-[clamp(60px,10.4vw,170px)]',
} = Astro.props;
---
<!--
  Brand-level hero. It speaks for every trailer (the power is on board), not for one buyer.
  PLACEHOLDER: the loop is a concept render from spogtrailers.com. The poster shows for reduced motion.
-->
<header id="top" class="grain relative flex h-screen min-h-[720px] items-end overflow-hidden bg-night">
  <video
    class="absolute inset-0 size-full object-cover brightness-[.66] saturate-[.9] sepia-[.12] contrast-[1.06]"
    autoplay muted loop playsinline preload="metadata" poster={img.statementPoster} data-motion-video
  >
    <source src={img.statementVideo} type="video/mp4" />
  </video>
  <div class="scrim-hero absolute inset-0 z-[1]"></div>
  <div class="wrap relative z-[3] w-full pb-16">
    {eyebrow && <Eyebrow gold={eyebrow.gold} text={eyebrow.text} class="block animate-rise-1" />}
    <h1 class:list={['m-0 animate-rise-1', eyebrow && 'mt-6', 'font-black uppercase leading-[.84] tracking-[0em] text-white', size]}>
      {heading.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}
    </h1>
    <div class="mt-[34px] flex animate-rise-2 flex-wrap items-end justify-between gap-[30px]">
      <p class="m-0 max-w-[460px] text-[18px] text-white/82">{sub}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={primary.href} variant="gold" arrow>{primary.label}</Button>
        <Button href={secondary.href}>{secondary.label}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-motion-video]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
