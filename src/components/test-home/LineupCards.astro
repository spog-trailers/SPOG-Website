---
import { cards, wordmark, firstWordDialog } from '../../data/testHome';
// The lineup, after Tesla's homepage card row: one card per trailer, nothing but a category,
// the name in that trailer's own type, a status line and the buttons. The look lives in the
// photo grade and the name. Swipe or use the arrows. Coming-next cards open a small signup.
const btn = 'inline-flex h-[44px] items-center justify-center border-[1.5px] px-[22px] t-btn no-underline cursor-pointer max-[560px]:flex-1 max-[560px]:px-3';
const field = 'h-[52px] w-full rounded-[10px] border border-panel-line bg-black px-4 text-[16px] text-white placeholder:text-[#8a8a8a] focus-visible:border-gold';
import { srcset } from '../../data/content';
---
<section id="lineup" aria-label="The lineup" class="bg-stone pb-16 pt-12 max-[640px]:pb-12 max-[640px]:pt-8">
  <div class="relative">
    <ul data-track class="no-scrollbar m-0 flex list-none snap-x snap-mandatory gap-5 overflow-x-auto p-0 px-[max(36px,calc((100vw_-_1320px)/2_+_36px))] scroll-px-[max(36px,calc((100vw_-_1320px)/2_+_36px))] max-[640px]:gap-3 max-[640px]:px-5 max-[640px]:scroll-px-5">
      {cards.map((c) => {
        const studio = c.look === 'studio';
        return (
          <li class="@container relative aspect-[16/9] w-[min(1000px,68vw)] shrink-0 snap-start overflow-hidden rounded-[18px] bg-night max-[760px]:aspect-[4/5] max-[760px]:w-[86vw]" data-card data-look={c.look}>
            <img src={c.image} srcset={srcset(c.image)} sizes="(max-width: 760px) 86vw, min(1000px, 68vw)" alt={c.alt} loading="lazy" style={`object-position:${c.position}`} class="lc-img absolute inset-0 size-full object-cover" />
            <div class="lc-scrim absolute inset-0"></div>
            {c.look === 'relief' && (
              <div class="pointer-events-none absolute inset-[18px]" aria-hidden="true">
                <i class="absolute left-0 top-0 size-5 border-l-2 border-t-2 border-gold"></i>
                <i class="absolute right-0 top-0 size-5 border-r-2 border-t-2 border-gold"></i>
                <i class="absolute bottom-0 left-0 size-5 border-b-2 border-l-2 border-gold"></i>
                <i class="absolute bottom-0 right-0 size-5 border-b-2 border-r-2 border-gold"></i>
              </div>
            )}

            <div class:list={['relative z-[1] flex h-full flex-col justify-between p-[clamp(24px,4cqw,44px)]', studio ? 'text-ink' : 'text-white']}>
              <span class="text-[15px] font-semibold tracking-[-.005em]">{c.category}</span>
              <div>
                <h3
                  class:list={['lc-name m-0 leading-[.95]', wordmark[c.id], c.look === 'garage' && 'pl-[.08em]']}
                  style={`font-size:${c.size}cqw`}
                >{c.look === 'relief' ? <>Disaster<br />Relief</> : c.name}</h3>
                {c.look === 'garage' && <i class="mt-4 block h-px w-[34%] bg-[linear-gradient(90deg,var(--color-gold),rgb(238_161_20/0))]"></i>}
                <p class:list={['mb-0 mt-3 flex items-center gap-2 text-[15px] font-medium', studio ? 'text-ink-soft' : 'text-white/80']}>
                  <i class:list={['size-1.5 rounded-full', c.live ? 'bg-gold' : studio ? 'bg-ink-soft' : 'bg-white/60']}></i>{c.status}
                </p>
                <div class="mt-6 flex flex-wrap gap-2.5 max-[560px]:mt-5">
                  {c.live ? (
                    <>
                      <a href="#cta" data-trailer={c.name} class={`${btn} border-gold bg-gold text-black hover:border-white hover:bg-white`}>Reserve</a>
                      <a href={c.href} class:list={[btn, studio ? 'border-ink text-ink hover:bg-ink hover:text-white' : 'border-white/80 text-white hover:border-white hover:bg-white hover:text-black']}>Learn more</a>
                    </>
                  ) : (
                    <button type="button" data-first-word={c.name} class={`${btn} border-white/80 bg-black/30 text-white backdrop-blur-[6px] hover:border-white hover:bg-white hover:text-black`}>{firstWordDialog.cta}</button>
                  )}
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>

    <button type="button" data-step="-1" aria-label="Previous trailer" class="lc-arrow left-[max(14px,calc((100vw_-_1320px)/2_+_14px))]">
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" data-step="1" aria-label="Next trailer" class="lc-arrow right-[max(14px,calc((100vw_-_1320px)/2_+_14px))]">
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>

  <div class="mt-6 flex justify-center gap-2" data-dots aria-hidden="true">
    {cards.map(() => <i class="size-2 rounded-full bg-ink/20 transition-colors data-[on]:bg-ink"></i>)}
  </div>
</section>

<!-- Coming-next signup. TODO: connect to GoHighLevel and tag the trailer. Read the GHL SOP in Notion first. -->
<dialog id="first-word" aria-labelledby="fw-title" class="m-auto w-[min(480px,calc(100vw_-_32px))] rounded-[22px] border border-panel-line bg-panel p-0 text-bone backdrop:bg-black/70 backdrop:backdrop-blur-[4px]">
  <form method="dialog" class="px-8 pb-8 pt-9 max-[560px]:px-6">
    <button value="cancel" aria-label="Close" class="absolute right-4 top-4 grid size-9 cursor-pointer place-items-center rounded-full border-0 bg-transparent text-mute hover:text-white">
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <h3 id="fw-title" class="m-0 text-[28px] font-semibold tracking-[-.025em] text-white">{firstWordDialog.heading}</h3>
    <p class="mb-0 mt-2 text-[16px] text-mute">{firstWordDialog.sub}</p>
    <label for="fwd-email" class="sr-only">Email</label>
    <input id="fwd-email" type="email" autofocus autocomplete="email" placeholder="you@company.com" class={`${field} mt-6`} />
    <label for="fwd-trailer" class="sr-only">Trailer</label>
    <select id="fwd-trailer" class={`${field} mt-2.5 cursor-pointer`}>
      {firstWordDialog.options.map((o) => <option>{o}</option>)}
      <option>All of them</option>
    </select>
    <button value="ok" class="mt-4 h-[52px] w-full cursor-pointer border-[1.5px] border-white bg-white t-btn text-black hover:border-gold hover:bg-gold">{firstWordDialog.cta}</button>
  </form>
</dialog>

<style>
  /* Per-trailer photo grade and scrim. Same card, different light. */
  [data-look='work'] .lc-img { filter: brightness(.82) sepia(.14) contrast(1.08) saturate(.92); }
  [data-look='work'] .lc-scrim { background: linear-gradient(to top, rgb(0 0 0 / .78), rgb(0 0 0 / .1) 55%), linear-gradient(to bottom, rgb(0 0 0 / .45), rgb(0 0 0 / 0) 22%); }
  /* Cargo: the studio render stands whole on the right, its edges fading into a matching backdrop. */
  [data-look='studio'] { background: radial-gradient(ellipse 55% 85% at 74% 48%, #efeeec 0%, #d5d3d0 55%, #b8b6b3 100%); }
  [data-look='studio'] .lc-img {
    left: auto; right: 7%; width: auto; aspect-ratio: 980 / 1232;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent);
  }
  @media (max-width: 760px) {
    [data-look='studio'] { background: radial-gradient(ellipse 80% 60% at 50% 34%, #efeeec 0%, #d5d3d0 60%, #b8b6b3 100%); }
    [data-look='studio'] .lc-img { right: auto; left: 50%; top: 3%; height: 64%; translate: -50% 0; }
  }
  [data-look='event'] .lc-img { filter: brightness(.95) saturate(1.08); }
  [data-look='event'] .lc-scrim { background: linear-gradient(to top, rgb(0 0 0 / .8), rgb(0 0 0 / .05) 55%), linear-gradient(to bottom, rgb(0 0 0 / .55), rgb(0 0 0 / 0) 30%); }
  [data-look='event'] .lc-name { text-indent: .3em; text-shadow: 0 0 40px rgb(255 240 220 / .3); }
  [data-look='garage'] .lc-img { filter: brightness(.82) contrast(1.12); }
  [data-look='garage'] .lc-scrim { background: radial-gradient(ellipse 80% 90% at 70% 45%, rgb(0 0 0 / 0) 30%, rgb(0 0 0 / .85) 100%), linear-gradient(to top, rgb(0 0 0 / .7), rgb(0 0 0 / 0) 50%); }
  [data-look='relief'] .lc-img { filter: brightness(.6) saturate(.5) contrast(1.18); }
  [data-look='relief'] .lc-scrim {
    background:
      linear-gradient(to top, rgb(5 5 5 / .8), rgb(5 5 5 / 0) 60%),
      linear-gradient(rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 48px 48px;
  }
  [data-look='camper'] .lc-img { filter: brightness(.96) saturate(.95); }
  [data-look='camper'] .lc-scrim { background: linear-gradient(to top, rgb(0 0 0 / .62), rgb(0 0 0 / 0) 50%); }

  .lc-img { transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  [data-card]:hover .lc-img { transform: scale(1.03); }

  .lc-arrow {
    position: absolute; top: 50%; translate: 0 -50%; z-index: 2;
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1.5px solid rgb(255 255 255 / .7); background: rgb(0 0 0 / .45); color: #fff;
    backdrop-filter: blur(6px); cursor: pointer;
  }
  .lc-arrow:hover { background: #fff; color: #000; }
  .lc-arrow:disabled { opacity: 0; pointer-events: none; }
  @media (max-width: 760px) { .lc-arrow { display: none; } }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const cardEls = [...track.querySelectorAll<HTMLElement>('[data-card]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dots] i')];
  const prev = document.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
  const next = document.querySelector<HTMLButtonElement>('[data-step="1"]')!;
  const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  const step = () => cardEls[1].offsetLeft - cardEls[0].offsetLeft;
  const index = () => Math.round(track.scrollLeft / step());
  function sync() {
    const i = index();
    dots.forEach((d, n) => d.toggleAttribute('data-on', n === i));
    prev.disabled = track.scrollLeft < 4;
    next.disabled = track.scrollLeft > track.scrollWidth - track.clientWidth - 4;
  }
  [prev, next].forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.step) * step(), behavior: smooth })));
  track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
  window.addEventListener('resize', sync);
  sync();

  // Reserve on a card preselects that trailer in the walkthrough form further down.
  const wt = document.getElementById('wt-trailer') as HTMLSelectElement | null;
  document.querySelectorAll<HTMLAnchorElement>('a[data-trailer]').forEach((a) =>
    a.addEventListener('click', () => { if (wt) wt.value = a.dataset.trailer ?? ''; }),
  );

  // Coming-next cards open the signup with their trailer picked.
  const dialog = document.getElementById('first-word') as HTMLDialogElement;
  const pick = document.getElementById('fwd-trailer') as HTMLSelectElement;
  document.querySelectorAll<HTMLButtonElement>('[data-first-word]').forEach((b) =>
    b.addEventListener('click', () => { pick.value = b.dataset.firstWord ?? ''; dialog.showModal(); }),
  );
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
