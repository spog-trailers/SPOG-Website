---
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import { lineup, tiles, wordmark, numbers } from '../../data/testHome';
// Tesla and Rivian put every vehicle on the homepage in one shared frame. This is that row:
// same tile for all six, but each name is set in its trailer's own type, like Tesla's
// Cybertruck and Roadster cards. The power numbers sit under it as the shared spine.
const cols: Record<number, string> = {
  1: 'grid-cols-[repeat(1,1fr)]',
  2: 'grid-cols-[repeat(2,1fr)]',
  3: 'grid-cols-[repeat(3,1fr)]',
};
---
<section id="lineup" aria-label="The lineup" class="bg-black pb-[110px] pt-[120px] text-bone max-[640px]:pb-20 max-[640px]:pt-20">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <div>
        <Eyebrow gold={lineup.eyebrow} />
        <Heading class="mt-4 text-white">{lineup.heading}</Heading>
      </div>
      <p class="m-0 max-w-[420px] text-[17px] text-mute">{lineup.sub}</p>
    </div>

    <div class="mt-14 grid grid-cols-[2fr_1fr_3fr] gap-x-6 gap-y-12 max-[1000px]:grid-cols-[repeat(1,1fr)]">
      {lineup.groups.map((g) => (
        <div class="min-w-0">
          <span class="block border-b border-line pb-3 text-[11px] font-semibold uppercase tracking-[.22em] text-mute">{g.label}</span>
          <ul class:list={['m-0 mt-5 grid list-none gap-4 p-0 max-[560px]:flex max-[560px]:snap-x max-[560px]:overflow-x-auto no-scrollbar', cols[g.ids.length]]}>
            {g.ids.map((id) => {
              const t = tiles[id];
              return (
                <li class="min-w-0 max-[560px]:w-[68vw] max-[560px]:shrink-0 max-[560px]:snap-start">
                  <a href={`#show-${id}`} class="group block text-inherit no-underline">
                    <div class="aspect-[4/3] overflow-hidden rounded-[14px] bg-panel">
                      <img src={t.image} alt={t.alt} loading="lazy" style={`object-position:${t.position}`} class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.05]" />
                    </div>
                    <span class="mt-4 block text-[11px] font-semibold uppercase tracking-[.2em] text-mute">{t.for}</span>
                    <b class:list={['mt-1.5 block text-[21px] leading-[1.15] text-white', wordmark[id]]}>{t.name}</b>
                    <span class:list={['mt-3 flex items-center gap-2 text-[12px] font-semibold', t.live ? 'text-gold' : 'text-mute']}>
                      <i class:list={['size-1.5 rounded-full', t.live ? 'bg-gold' : 'bg-mute']}></i>{t.live ? 'Available now' : 'Coming next'}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <ul class="m-0 mt-20 grid list-none grid-cols-[repeat(3,1fr)] border-t border-line p-0 max-[760px]:grid-cols-[repeat(1,1fr)] max-[760px]:mt-14">
      {numbers.map((n) => (
        <li class="pt-8 not-first:border-l not-first:border-line not-first:pl-10 max-[760px]:not-first:border-l-0 max-[760px]:not-first:border-t max-[760px]:not-first:pl-0 max-[760px]:pb-6">
          <small class="block text-[14px] font-medium text-bone/75">{n.label}</small>
          <strong class:list={['my-1.5 block whitespace-nowrap text-[clamp(40px,4.4vw,64px)] font-extrabold leading-none tracking-[-.05em]', n.gold ? 'text-gold-metal' : 'text-steel']}>{n.value}</strong>
          <span class="text-[14px] text-mute">{n.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
