---
/**
 * Section title in the work look (Cargo and Workstation): the heading alone, in heavy uppercase.
 * No small label above it. Nate cut those on 2026-11-19 because they read as AI-made.
 * size: "lg" for chapter openers, "md" for quieter bands.
 */
interface Props { lines: string[]; as?: 'h2' | 'h3'; size?: 'lg' | 'md'; tone?: 'light' | 'dark'; class?: string }
const { lines, as: Tag = 'h2', size = 'lg', tone = 'light', class: extra = '' } = Astro.props;
const sizes = { lg: 'text-[clamp(36px,4.6vw,66px)]', md: 'text-[clamp(30px,3.2vw,46px)]' };
---
<div class={extra}>
  <Tag class:list={[
    'm-0 font-black uppercase leading-[.92] tracking-[-.045em]',
    sizes[size],
    tone === 'light' ? 'text-coal' : 'text-white',
  ]}>
    {lines.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}
  </Tag>
</div>
