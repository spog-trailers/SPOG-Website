---
import WorkTitle from './WorkTitle.astro';
import { options, optionsHead } from '../../data/workstationPage';
import { small, srcset } from '../../data/content';
// Options and add-ons, after the accessory sections on the Rivian and Tesla pages: one big
// photo per option, alternating sides, with a short line next to it. The photo takes two
// thirds of the row so the add-on is the first thing you see.
---
<section id="options" aria-label="Options" class="bg-white pb-[140px] pt-[130px] text-ink max-[640px]:pb-20 max-[640px]:pt-20">
  <div class="wrap">
    <WorkTitle lines={optionsHead.heading} />
  </div>
  <div class="wrap mt-16 grid gap-[110px] max-[900px]:mt-12 max-[900px]:gap-16">
    {options.map((o, i) => (
      <article class:list={['grid items-center gap-x-16 gap-y-8 max-[900px]:grid-cols-[minmax(0,1fr)]', i % 2 ? 'grid-cols-[minmax(0,4fr)_minmax(0,8fr)]' : 'grid-cols-[minmax(0,8fr)_minmax(0,4fr)]']}>
        <div class:list={['grid gap-3', o.more && 'grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] max-[640px]:grid-cols-[minmax(0,1fr)]', i % 2 && 'min-[901px]:order-2']}>
          <img
            src={o.image}
            srcset={srcset(o.image)}
            sizes="(max-width: 900px) 100vw, 62vw"
            alt={o.alt}
            loading="lazy"
            class="block aspect-[4/3] h-full w-full rounded-[18px] object-cover max-[640px]:rounded-[14px]"
            style={`object-position:${o.position}`}
          />
          {o.more && (
            <img src={small(o.more.src)} alt={o.more.alt} loading="lazy" class="block h-full w-full rounded-[18px] object-cover max-[640px]:hidden" />
          )}
        </div>
        <div>
          <h3 class="m-0 t-h3 text-coal">{o.title}</h3>
          <p class="mb-0 mt-4 max-w-[400px] t-body text-ink-soft">{o.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
