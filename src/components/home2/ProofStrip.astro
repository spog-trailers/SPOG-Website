---
import { proof } from '../../data/home2';
// The US flag at its official proportions (Nate, 2026-11-18): 19:10, 13 stripes, a blue field
// over seven of them and 50 stars in rows of six and five. Drawn on a 190 x 100 grid.
const stripe = 100 / 13;
const star = (cx: number, cy: number, r = 3.08) =>
  Array.from({ length: 10 }, (_, k) => {
    const a = (-90 + k * 36) * (Math.PI / 180);
    const d = k % 2 ? r * 0.382 : r;
    return `${k ? 'L' : 'M'}${(cx + d * Math.cos(a)).toFixed(2)} ${(cy + d * Math.sin(a)).toFixed(2)}`;
  }).join('') + 'Z';
const stars = Array.from({ length: 9 }, (_, row) =>
  (row % 2 ? [2, 4, 6, 8, 10] : [1, 3, 5, 7, 9, 11]).map((col) => star(col * (76 / 12), (row + 1) * (stripe * 7 / 10))).join(''),
).join('');
/**
 * Thin strip under the hero: the Built in the USA badge and three short customer quotes.
 * PLACEHOLDER: there are no approved quotes yet. A slot without a quote shows as an empty,
 * dashed box that only names who the quote will come from, so nothing here is made up.
 * Fill `quote` and `name` in src/data/home2.ts and the slot turns into a real quote.
 */
---
<section aria-label="Built in the USA" class="border-b border-line bg-black py-7">
  <div class="wrap grid grid-cols-[auto_repeat(3,minmax(0,1fr))] items-stretch gap-4 max-[960px]:grid-cols-[repeat(1,minmax(0,1fr))]">
    <p class="m-0 flex items-center gap-3 pr-8 t-label text-white max-[960px]:pb-1">
      <svg viewBox="0 0 190 100" class="h-[22px] w-auto shrink-0" role="img" aria-label="United States flag">
        <clipPath id="us-flag-edge"><rect width="190" height="100" rx="5" /></clipPath>
        <g clip-path="url(#us-flag-edge)">
          <rect width="190" height="100" fill="#B22234" />
          {[1, 3, 5, 7, 9, 11].map((i) => <rect y={i * stripe} width="190" height={stripe} fill="#FFFFFF" />)}
          <rect width="76" height={stripe * 7} fill="#3C3B6E" />
          <path d={stars} fill="#FFFFFF" />
        </g>
      </svg>
      {proof.badge}
    </p>
    {proof.slots.map((s) => s.quote ? (
      <figure class="m-0 rounded-[12px] bg-panel px-5 py-4">
        <blockquote class="m-0 t-body-sm text-bone">&ldquo;{s.quote}&rdquo;</blockquote>
        <figcaption class="mt-2 t-fine text-mute">{s.name}, {s.who}</figcaption>
      </figure>
    ) : (
      <div class="rounded-[12px] border border-dashed border-white/20 px-5 py-4">
        <span class="block t-label text-mute">{s.who}</span>
        <span class="mt-1.5 block t-fine text-white/45">Customer quote to come</span>
      </div>
    ))}
  </div>
</section>
