---
import { future } from '../../data/home2';
import { wordmark } from '../../data/testHome';
import { srcset } from '../../data/content';
/**
 * Our future lineup: Garage, Disaster Relief and Camper, one compact card each in the looks Nate
 * liked on /test-home (Garage black with a slanted metal name, Disaster Relief with the field grid
 * and gold corners, Camper in natural light). No specs and no Reserve. "Join the waitlist" opens a
 * small signup with that trailer picked. Light section, after the dark feature cards.
 * Runs wider than the page container, like the solution cards. A small note under the row says
 * the images are concept renderings (Nate, 2026-11-18).
 * The lineup strip and the footer's Future lineup link jump here (#future).
 */
const btn = 'inline-flex h-[44px] cursor-pointer items-center justify-center border-[1.5px] border-white/80 bg-black/30 px-[22px] text-[11.5px] font-bold uppercase leading-[normal] tracking-[.2em] text-white backdrop-blur-[6px] hover:border-white hover:bg-white hover:text-black';
const field = 'h-[52px] w-full rounded-[10px] border border-panel-line bg-black px-4 text-[16px] text-white placeholder:text-[#8a8a8a] focus-visible:border-gold';
const gutter = 'mx-auto max-w-[1920px] px-6 max-[640px]:px-5';
const row = 'm-0 mt-12 grid list-none grid-cols-[repeat(3,minmax(0,1fr))] gap-4 p-0 max-[900px]:no-scrollbar max-[900px]:-mx-6 max-[900px]:flex max-[900px]:snap-x max-[900px]:snap-mandatory max-[900px]:overflow-x-auto max-[900px]:px-6 max-[900px]:scroll-px-6 max-[640px]:-mx-5 max-[640px]:mt-9 max-[640px]:gap-3 max-[640px]:px-5 max-[640px]:scroll-px-5';
---
<section id="future" aria-label="Our future lineup" class="bg-stone pb-[110px] pt-[110px] text-ink max-[640px]:pb-16 max-[640px]:pt-16">
  <div class={gutter}>
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
      <h2 class="m-0 text-[clamp(32px,3.6vw,48px)] font-semibold leading-[1.05] tracking-[-.035em] text-coal">{future.heading}</h2>
      <p class="m-0 max-w-[440px] text-[16.5px] leading-[1.55] text-ink-soft">{future.sub}</p>
    </div>
    <ul class={row}>
      {future.cards.map((c) => (
        <li class="@container relative aspect-[1/1] min-w-0 overflow-hidden rounded-[18px] bg-night max-[900px]:aspect-[4/5] max-[900px]:w-[min(80vw,440px)] max-[900px]:shrink-0 max-[900px]:snap-start" data-look={c.look}>
          <img src={c.image} srcset={srcset(c.image)} sizes="(max-width: 900px) 80vw, 33vw" alt={c.alt} loading="lazy" style={`object-position:${c.position}`} class="fl-img absolute inset-0 size-full object-cover" />
          <div class="fl-scrim absolute inset-0"></div>
          {c.look === 'relief' && (
            <div class="pointer-events-none absolute inset-[16px]" aria-hidden="true">
              <i class="absolute left-0 top-0 size-5 border-l-2 border-t-2 border-gold"></i>
              <i class="absolute right-0 top-0 size-5 border-r-2 border-t-2 border-gold"></i>
              <i class="absolute bottom-0 left-0 size-5 border-b-2 border-l-2 border-gold"></i>
              <i class="absolute bottom-0 right-0 size-5 border-b-2 border-r-2 border-gold"></i>
            </div>
          )}
          <div class="relative z-[1] flex h-full flex-col justify-end p-[clamp(22px,6cqw,40px)] text-white">
            <div>
              <h3 class:list={['fl-name m-0 leading-[.95]', wordmark[c.id], c.look === 'garage' && 'pl-[.08em]']} style={`font-size:${c.size}cqw`}>
                {c.look === 'relief' ? <>Disaster<br />Relief</> : c.name}
              </h3>
              {c.look === 'garage' && <i class="mt-3 block h-px w-[34%] bg-[linear-gradient(90deg,var(--color-gold),rgb(238_161_20/0))]"></i>}
              <p class="mb-0 mt-3 max-w-[30ch] text-[15px] leading-[1.45] text-white/80">{c.line}</p>
              <button type="button" data-fl-pick={c.name} class={`${btn} mt-5`}>{future.cta}</button>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="mb-0 mt-5 flex items-start gap-2.5 text-[13px] leading-[1.5] text-ink-soft max-[640px]:mt-4 max-[640px]:text-[12.5px]">
      <svg viewBox="0 0 20 20" class="mt-px size-4 shrink-0 fill-none stroke-current stroke-[1.5]" aria-hidden="true"><circle cx="10" cy="10" r="8" /><path d="M10 9v5M10 6.2v.1" stroke-linecap="round" /></svg>
      {future.disclaimer}
    </p>
  </div>
</section>

<!-- Future lineup signup. TODO: connect to GoHighLevel and tag the trailer. Read the GoHighLevel SOP in Notion first. -->
<dialog id="fl-dialog" aria-labelledby="fl-title" class="m-auto w-[min(480px,calc(100vw_-_32px))] rounded-[22px] border border-panel-line bg-panel p-0 text-bone backdrop:bg-black/70 backdrop:backdrop-blur-[4px]">
  <form method="dialog" class="px-8 pb-8 pt-9 max-[560px]:px-6">
    <button value="cancel" aria-label="Close" class="absolute right-4 top-4 grid size-9 cursor-pointer place-items-center rounded-full border-0 bg-transparent text-mute hover:text-white">
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <h3 id="fl-title" class="m-0 text-[28px] font-semibold tracking-[-.025em] text-white">{future.dialogHeading}</h3>
    <p class="mb-0 mt-2 text-[16px] text-mute">{future.sub}</p>
    <label for="fl-email" class="sr-only">Email</label>
    <input id="fl-email" type="email" autofocus autocomplete="email" placeholder="you@company.com" class={`${field} mt-6`} />
    <label for="fl-trailer" class="sr-only">Trailer</label>
    <select id="fl-trailer" class={`${field} mt-2.5 cursor-pointer`}>
      {future.cards.map((c) => <option>{c.name}</option>)}
      <option>All of them</option>
    </select>
    <button value="ok" class="mt-4 h-[52px] w-full cursor-pointer border-[1.5px] border-white bg-white text-[12px] font-bold uppercase leading-[normal] tracking-[.2em] text-black hover:border-gold hover:bg-gold">{future.cta}</button>
  </form>
</dialog>

<style>
  /* Per-trailer grade and scrim, from the /test-home lineup cards. */
  [data-look='garage'] .fl-img { filter: brightness(.82) contrast(1.12); }
  [data-look='garage'] .fl-scrim { background: radial-gradient(ellipse 80% 90% at 70% 45%, rgb(0 0 0 / 0) 30%, rgb(0 0 0 / .85) 100%), linear-gradient(to top, rgb(0 0 0 / .75), rgb(0 0 0 / 0) 55%); }
  [data-look='relief'] .fl-img { filter: brightness(.6) saturate(.5) contrast(1.18); }
  [data-look='relief'] .fl-scrim {
    background:
      linear-gradient(to top, rgb(5 5 5 / .82), rgb(5 5 5 / 0) 62%),
      linear-gradient(rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(255 255 255 / .06) 1px, transparent 1px) 0 0 / 40px 40px;
  }
  [data-look='camper'] .fl-img { filter: brightness(.96) saturate(.95); }
  [data-look='camper'] .fl-scrim { background: linear-gradient(to top, rgb(0 0 0 / .7), rgb(0 0 0 / 0) 58%), linear-gradient(to bottom, rgb(0 0 0 / .35), rgb(0 0 0 / 0) 25%); }

  .fl-img { transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  li:hover .fl-img { transform: scale(1.03); }
</style>

<script>
  // "Join the waitlist" opens the signup with that trailer picked.
  const dialog = document.getElementById('fl-dialog') as HTMLDialogElement | null;
  const pick = document.getElementById('fl-trailer') as HTMLSelectElement | null;
  if (dialog && pick) {
    document.querySelectorAll<HTMLButtonElement>('[data-fl-pick]').forEach((b) =>
      b.addEventListener('click', () => { pick.value = b.dataset.flPick ?? ''; dialog.showModal(); }),
    );
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
