---
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import { lineupCards, lineupEntry, type ProductId } from '../../data/productPages';

// Rivian's "Find the R1T that's right for you", across the three trailers on sale now.
// No stats on the cards: the page already shows this product's numbers twice.
interface Props { current: ProductId }
const { current } = Astro.props;
---
<section id="lineup" aria-label="The 2027 lineup" class="bg-stone py-[120px] text-ink max-[640px]:py-20">
  <div class="wrap">
    <Heading center>Find the SPOG that fits.</Heading>
    <p class="mx-auto mb-0 mt-[18px] max-w-[600px] text-center text-[19px] text-ink-soft">Three trailers you can order now, all on one power system.</p>

    <ul class="mt-14 grid grid-cols-[repeat(3,1fr)] gap-3 max-[900px]:grid-cols-[repeat(1,1fr)]">
      {lineupCards.map((c) => {
        const p = lineupEntry(c.id);
        const here = c.id === current;
        return (
          <li class:list={['flex flex-col overflow-hidden rounded-[20px] bg-paper', here && 'ring-2 ring-gold']}>
            <img src={c.image} alt={c.alt} loading="lazy" style={`object-position:${c.position}`} class="block aspect-[4/3] w-full object-cover max-[900px]:aspect-[16/9]" />
            <div class="flex flex-1 flex-col px-7 pb-7 pt-6">
              <b class="block text-[34px] font-black uppercase leading-none tracking-[-.045em]">{p.name}</b>
              <span class="mt-2.5 block text-[16.5px] text-ink-soft">{p.tag}</span>
              <div class="mt-auto pt-7">
                {here ? (
                  <span class="inline-flex h-[50px] items-center text-[12px] font-bold uppercase tracking-[.2em] text-ink-soft">You're looking at it</span>
                ) : (
                  <Button href={`/${c.id}`} variant="ink" arrow>Explore {p.name}</Button>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    <a href="/#future" class="mt-[34px] block text-center text-[15px] font-semibold text-ink underline underline-offset-[5px]">See our future lineup &rarr;</a>
  </div>
</section>
