---
/** Section heading used across light and dark sections. */
interface Props { as?: 'h2' | 'h3'; center?: boolean; class?: string }
const { as: Tag = 'h2', center = false, class: extra = '' } = Astro.props;
---
<Tag class:list={[
  'm-0 t-h2',
  center && 'mx-auto max-w-[900px] text-center',
  extra,
]}><slot /></Tag>
