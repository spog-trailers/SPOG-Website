---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Heading from '../ui/Heading.astro';
import { products, nextUp } from '../../data/content';
const field = 'rounded-[10px] border border-panel-line bg-black px-4 py-[14px] text-[16px] text-white placeholder:text-[#8a8a8a] focus-visible:border-gold';
// "5 to 20 kWh" -> ["5 to 20", "kWh"], so the unit can be set smaller beside the number
const splitUnit = (v: string): [string, string] => {
  const m = v.match(/^(.*?)\s?(kWh|W|ft)$/);
  return m ? [m[1], m[2]] : [v, ''];
};
---
<!--
  The 2027 lineup, Tesla-style. Trailers you can order now get full rows and Reserve buttons.
  Future trailers sit underneath, smaller, with an interest signup instead.

  Each lineup row: the name set huge across the top, the photo and a quiet panel sliding up over
  the bottom of the letters. Photo side alternates per row. The panel is kept minimal on purpose:
  who it's for, one line, three numbers, Reserve and a link to the product page (the full specs
  live there). A product with no photo yet (image: '') renders as a shorter typographic row.
-->
<section id="specs" aria-label="The 2027 lineup" class="bg-black py-[130px] text-bone">
  <div class="wrap">
    <Heading center class="text-white">Pick your SPOG.</Heading>
    <p class="mx-auto mt-[18px] max-w-[600px] text-center text-[19px] text-mute">Three trailers you can order now, all on one power system.</p>

    <Eyebrow gold="Available now" text="The 2027 lineup" class="mt-16 block" />
    <div class="mt-6 grid gap-6">
      {products.map((p, i) => (
        <article id={p.id} class="@container overflow-hidden rounded-[24px] border border-[#1f1f22] bg-panel" style={`--fit:${p.fit}cqw`}>
          <h3 class:list={[
            'text-steel m-0 whitespace-nowrap px-[2.6cqw] pt-[3cqw] text-[12.4cqw] font-black uppercase leading-[.74] tracking-[-.055em] max-[900px]:text-center max-[900px]:text-(length:--fit)',
            i % 2 ? 'text-right' : 'text-left',
          ]}>{p.name}</h3>

          {p.image ? (
            <div class="relative z-[1] -mt-[3.4cqw] grid grid-cols-[1.25fr_1fr] bg-panel max-[900px]:grid-cols-[minmax(0,1fr)]">
              <div class:list={['relative', i % 2 && 'order-2 max-[900px]:order-none']}>
                <img src={p.image} alt={p.alt} style={`object-position:${p.position}`} class="block aspect-[5/4] size-full object-cover" />
              </div>

              <div class="flex flex-col justify-center px-[clamp(28px,4.6cqw,72px)] py-[clamp(40px,4.6cqw,72px)]">
                <span class="text-[11.5px] font-semibold uppercase tracking-[.22em] text-gold">{p.badge}</span>
                <p class="mb-0 mt-4 text-[clamp(22px,2.2cqw,30px)] font-semibold leading-[1.15] tracking-[-.025em] text-white">{p.tag}</p>

                <dl class="mb-0 mt-[clamp(32px,3.6cqw,52px)] flex flex-wrap gap-x-[clamp(22px,2.8cqw,44px)] gap-y-6">
                  {p.stats.map(([k, v]) => {
                    const [num, unit] = splitUnit(v);
                    return (
                      <div>
                        <dt class="whitespace-nowrap text-[11px] font-semibold uppercase tracking-[.16em] text-mute">{k}</dt>
                        <dd class="m-0 mt-2 whitespace-nowrap text-[clamp(18px,1.8cqw,23px)] font-extrabold leading-[1.15] tracking-[-.02em] text-white">
                          {num}{unit && <span class="ml-[.2em] text-[.68em] font-semibold tracking-normal text-bone/70">{unit}</span>}
                        </dd>
                      </div>
                    );
                  })}
                </dl>

                <div class="mt-[clamp(36px,4cqw,56px)] flex flex-wrap items-center gap-x-8 gap-y-4">
                  <Button href="#cta" variant="gold">{p.cta}</Button>
                  <a href={p.id === 'cargo' ? '/cargo-2' : `/${p.id}`} class="text-[12px] font-bold uppercase leading-[normal] tracking-[.2em] text-white no-underline underline-offset-[6px] hover:underline">Explore {p.name} &rarr;</a>
                </div>
              </div>
            </div>
          ) : (
            <div class="relative z-[1] -mt-[3.4cqw] grid grid-cols-[1.35fr_1fr] items-end gap-8 border-t border-panel-line bg-panel px-[clamp(24px,3.4cqw,52px)] py-[clamp(28px,3.4cqw,48px)] max-[900px]:grid-cols-[minmax(0,1fr)]">
              <div>
                <span class="text-[11.5px] font-semibold uppercase tracking-[.22em] text-gold">{p.badge}</span>
                <p class="mb-0 mt-5 text-[clamp(22px,2.2cqw,30px)] font-semibold leading-[1.15] tracking-[-.025em] text-white">{p.tag}</p>
                <p class="mb-0 mt-3 max-w-[560px] text-[16.5px] text-mute">{p.body}</p>
              </div>
              <div class="flex flex-wrap justify-end gap-2.5 max-[900px]:justify-start">
                <Button href="#cta" variant="gold">{p.cta}</Button>
                <Button href="#walkthrough">Ask about {p.name}</Button>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
    <a href="#jobs" class="mt-[34px] block text-center text-[15px] font-semibold text-bone underline underline-offset-[5px]">Not sure which one fits? See it by job &rarr;</a>

    <!-- Coming next: future trailers, deliberately quieter than the lineup above -->
    <div id="next" class="mt-[110px] border-t border-line pt-[70px]">
      <Eyebrow gold={nextUp.eyebrow} />
      <h3 class="mb-0 mt-4 max-w-[640px] text-[clamp(28px,3.2vw,44px)] font-semibold leading-[1.08] tracking-[-.03em] text-white">{nextUp.heading}</h3>
      <p class="mb-0 mt-3 max-w-[560px] text-[17px] text-mute">{nextUp.sub}</p>

      <ul class="mt-10 grid grid-cols-[repeat(3,1fr)] gap-3 max-[860px]:grid-cols-[repeat(1,1fr)]">
        {nextUp.products.map((n) => (
          <li class="group relative aspect-[4/5] overflow-hidden rounded-[20px] border border-panel-line bg-panel max-[860px]:aspect-[4/3]">
            <img src={n.image} alt={n.alt} loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.05]" />
            <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(0_0_0/.92)_0%,rgb(0_0_0/.35)_45%,rgb(0_0_0/0)_70%)]"></div>
            <small class="absolute left-6 top-5 rounded-full bg-black/60 px-[11px] py-[7px] text-[10.5px] font-bold uppercase tracking-[.2em] text-bone backdrop-blur-[6px]">Coming next</small>
            <div class="absolute inset-x-6 bottom-6">
              <b class="block text-[clamp(28px,2.8vw,40px)] font-black uppercase leading-none tracking-[-.04em] text-white">{n.name}</b>
              <span class="mt-2.5 block text-[15.5px] text-bone/80">{n.body}</span>
            </div>
          </li>
        ))}
      </ul>

      <!-- TODO: connect this form to GoHighLevel (tag the lead with the trailer they picked) -->
      <form class="mt-6 flex flex-wrap gap-2" onsubmit="return false" aria-label="Get first word on future trailers">
        <label for="next-email" class="sr-only">Email</label>
        <input id="next-email" type="email" autocomplete="email" placeholder="you@company.com" class={`${field} min-w-[240px] flex-1`} />
        <label for="next-trailer" class="sr-only">Trailer</label>
        <select id="next-trailer" class={`${field} min-w-[200px] cursor-pointer`}>
          <option value="">Which trailer?</option>
          {nextUp.products.map((n) => <option>{n.name}</option>)}
          <option>All of them</option>
        </select>
        <button type="button" class="h-[52px] cursor-pointer border-[1.5px] border-white/70 bg-transparent px-[22px] text-[12px] font-bold uppercase leading-[normal] tracking-[.2em] text-white hover:border-white hover:bg-white hover:text-black max-[560px]:w-full">{nextUp.cta}</button>
      </form>
    </div>
  </div>
</section>
