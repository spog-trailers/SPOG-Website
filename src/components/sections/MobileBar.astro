---
// Phone-only action bar. Appears once the hero scrolls away and hides again at the Close section,
// so it never covers the hero buttons or the forms. Any section marked data-hide-mobilebar
// hides it too (the homepage lineup has its own buttons in the same spot).
const btn = 'flex h-12 flex-1 items-center justify-center border-[1.5px] t-btn no-underline';
// `cta` is the gold button and `secondary` the outlined one. The defaults match the nav's (Nate, 2026-11-18).
interface Props { cta?: { label: string; href: string }; secondary?: { label: string; href: string } }
const { cta = { label: 'Design yours', href: '/configure' }, secondary = { label: 'Book a demo', href: '/demo' } } = Astro.props;
---
<div
  id="mobilebar"
  class="fixed inset-x-0 bottom-0 z-30 hidden translate-y-full gap-2 border-t border-line bg-black/88 px-4 pb-[calc(12px+env(safe-area-inset-bottom,0px))] pt-3 backdrop-blur-[16px] transition-transform duration-300 data-[show]:translate-y-0 max-[640px]:flex"
>
  <a href={secondary.href} class={`${btn} border-white/70 text-white`}>{secondary.label}</a>
  <a href={cta.href} class={`${btn} border-gold bg-gold text-black`}>{cta.label}</a>
</div>

<script>
  const bar = document.getElementById('mobilebar')!;
  const hero = document.getElementById('top');
  const close = document.getElementById('cta');
  const inView = new Map<Element, boolean>();
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => inView.set(e.target, e.isIntersecting));
    bar.toggleAttribute('data-show', ![...inView.values()].some(Boolean));
  });
  [hero, close, ...document.querySelectorAll('[data-hide-mobilebar]')].forEach((el) => el && io.observe(el));
</script>
