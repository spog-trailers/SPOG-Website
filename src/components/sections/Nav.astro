---
import { img, navLinks, announcement } from '../../data/content';
// Nav buttons. A `small` label adds a second line above the action (the old homepage uses it).
const navBtn = 'flex h-11 flex-col justify-center border-[1.5px] px-4 leading-[normal] no-underline';
// `cta` is the gold button, `demo` the outlined one, `lineupHref` is where the announcement bar
// points and `links` are the nav links. The defaults are the homepage's buttons (Nate, 2026-11-18):
// Book a demo, and Design yours, which opens the "which trailer" page at /configure. A product
// page passes its own `cta`: the Cargo page goes straight to its builder, and Workstation and
// Event open the build request form with their trailer picked. /old-home passes its old buttons.
type NavButton = { small?: string; label: string; href: string };
interface Props { cta?: NavButton; demo?: NavButton; lineupHref?: string; links?: { label: string; href: string }[] }
const {
  cta = { label: 'Design yours', href: '/configure' },
  demo = { label: 'Book a demo', href: '/demo' },
  lineupHref = announcement.href,
  links = navLinks,
} = Astro.props;
---
<div
  id="masthead"
  class="fixed inset-x-0 top-[env(safe-area-inset-top,0px)] z-30 transition-transform duration-300 ease-out data-[tucked]:-translate-y-[34px]"
>
  <a href={lineupHref} class="flex h-[34px] items-center justify-center gap-3 border-b border-line bg-black px-4 t-label text-bone no-underline hover:text-white">
    <b class="font-semibold text-gold">{announcement.gold}</b>
    <span class="max-[640px]:hidden">{announcement.text}</span>
    <span class="underline underline-offset-4">{announcement.cta} &rarr;</span>
  </a>
  <nav aria-label="Main" class="h-16 border-b border-line bg-black/72 backdrop-blur-[16px]">
    <div class="wrap flex h-full items-center gap-10 max-[1320px]:gap-7 max-[640px]:px-5">
      <a href="/" class="shrink-0"><img src={img.logoWhite} alt="SPOG Solar Power Off Grid" class="h-6 w-auto" /></a>
      <ul class="flex gap-[30px] whitespace-nowrap max-[1320px]:gap-5 max-[1240px]:gap-4 max-[1190px]:hidden">
        {links.map((l) => (
          <li><a href={l.href} class="t-label text-[#C7CAD0] no-underline hover:text-white">{l.label}</a></li>
        ))}
      </ul>
      <div class="ml-auto flex gap-2.5 whitespace-nowrap">
        <a href={demo.href} class={`${navBtn} border-white/70 text-white hover:border-white hover:bg-white hover:text-black max-[640px]:hidden`}>
          {demo.small && <small class="t-fine opacity-70">{demo.small}</small>}
          <span class="t-btn">{demo.label}</span>
        </a>
        <a href={cta.href} class={`${navBtn} border-gold bg-gold text-black hover:border-white hover:bg-white`}>
          {cta.small && <small class="t-fine opacity-70">{cta.small}</small>}
          <span class="t-btn">{cta.label}</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  const masthead = document.getElementById('masthead')!;
  const tuck = () => masthead.toggleAttribute('data-tucked', window.scrollY > 40);
  tuck();
  window.addEventListener('scroll', tuck, { passive: true });
</script>
